#!/usr/bin/env bash
# Brightness Booster Script (Up to 200% Overdrive)

ACTION="$1"

get_current_b() {
    b_file="/tmp/.brightness_level"
    if [ -f "$b_file" ]; then
        cat "$b_file"
    else
        curr=$(brightnessctl -q g 2>/dev/null)
        max_b=$(brightnessctl -q m 2>/dev/null)
        if [ -n "$curr" ] && [ -n "$max_b" ]; then
            python3 -c "print(int(($curr / $max_b) * 100))"
        else
            echo "100"
        fi
    fi
}

set_brightness() {
    target=$1
    if [ "$target" -gt 200 ]; then target=200; fi
    if [ "$target" -lt 10 ]; then target=10; fi

    echo "$target" > "/tmp/.brightness_level"

    hw_val=$target
    if [ "$hw_val" -gt 100 ]; then hw_val=100; fi
    brightnessctl -q set "${hw_val}%" 2>/dev/null || true

    status="NORMAL"
    if [ "$target" -gt 100 ]; then
        status="OVERDRIVE 🚀 (200% MAX)"
    fi

    notify-send -h "int:value:$target" -h "string:synchronous:brightness" "Brightness: ${target}% [$status]" -t 1500
}

curr=$(get_current_b)

case "$ACTION" in
    "+5"|"+10"|"+15"|"+20")
        inc=${ACTION#+}
        set_brightness $((curr + inc))
        ;;
    "-5"|"-10"|"-15"|"-20")
        dec=${ACTION#-}
        set_brightness $((curr - dec))
        ;;
    *)
        if [[ "$ACTION" =~ ^[0-9]+$ ]]; then
            set_brightness "$ACTION"
        else
            echo "Usage: change-brightness [+5|-5|100|200]"
        fi
        ;;
esac
