#!/usr/bin/env python3
import os
import sys
import glob
import subprocess

BRIGHTNESS_FILE = "/tmp/.brightness_level"

def get_current_brightness():
    try:
        if os.path.exists(BRIGHTNESS_FILE):
            with open(BRIGHTNESS_FILE, "r") as f:
                return int(f.read().strip())
    except Exception:
        pass

    try:
        dirs = glob.glob('/sys/class/backlight/*')
        if dirs:
            dev = dirs[0]
            with open(os.path.join(dev, 'brightness'), 'r') as f:
                curr = int(f.read().strip())
            with open(os.path.join(dev, 'max_brightness'), 'r') as f:
                max_b = int(f.read().strip())
            return int((curr / max_b) * 100)
    except Exception:
        pass
    return 100

def set_brightness(val):
    val = max(10, min(100, int(val)))
    try:
        with open(BRIGHTNESS_FILE, "w") as f:
            f.write(str(val))
    except Exception:
        pass

    # 1. Hardware backlight via brightnessctl
    try:
        subprocess.Popen(['brightnessctl', '-q', 'set', f'{val}%'])
    except Exception:
        pass

    # 2. Systemd logind call
    try:
        dirs = glob.glob('/sys/class/backlight/*')
        for dev in dirs:
            dev_name = os.path.basename(dev)
            with open(os.path.join(dev, 'max_brightness'), 'r') as f:
                max_b = int(f.read().strip())
            target = max(1, int((val / 100.0) * max_b))
            subprocess.Popen(['busctl', 'call', 'org.freedesktop.login1', '/org/freedesktop/login1/session/auto', 'org.freedesktop.login1.Session', 'SetBrightness', 'ssu', 'backlight', dev_name, str(target)])
    except Exception:
        pass

def main():
    if len(sys.argv) < 2:
        return
    arg = sys.argv[1]
    curr = get_current_brightness()
    if arg.startswith("+"):
        diff = int(arg[1:])
        set_brightness(curr + diff)
    elif arg.startswith("-"):
        diff = int(arg[1:])
        set_brightness(curr - diff)
    else:
        try:
            set_brightness(int(arg))
        except ValueError:
            pass

if __name__ == "__main__":
    main()
