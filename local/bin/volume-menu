#!/usr/bin/env python3
import curses
import subprocess
import sys
import re
import tempfile
import os
import fcntl

def get_audio_info():
    try:
        res = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True)
        out = res.stdout.strip()
        vol = 0
        muted = False
        m = re.search(r"Volume:\s+([0-9.]+)", out)
        if m:
            vol = int(float(m.group(1)) * 100)
        if "[MUTED]" in out:
            muted = True
        return vol, muted
    except Exception:
        return 0, False

def set_volume(vol):
    vol = max(0, min(100, vol))
    subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{vol}%"], capture_output=True)

def toggle_mute():
    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], capture_output=True)

def safe_addstr(stdscr, y, x, string, attr=0):
    try:
        h, w = stdscr.getmaxyx()
        if y < h and x < w:
            max_len = max(0, w - x - 1)
            if len(string) > max_len:
                string = string[:max_len]
            stdscr.addstr(y, x, string, attr)
    except Exception:
        pass

def create_cava_config(num_bars=36, max_val=64):
    cfg_content = f"""
[general]
bars = {num_bars}
framerate = 60
sensitivity = 100

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = {max_val}
bar_delimiter = 59
"""
    tmp = tempfile.NamedTemporaryFile("w", delete=False, prefix="cava_vol_", suffix=".conf")
    tmp.write(cfg_content)
    tmp.close()
    return tmp.name

def main(stdscr):
    if curses.has_colors():
        curses.start_color()
        try:
            curses.use_default_colors()
        except Exception:
            pass

    curses.curs_set(0)
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)

    stdscr.timeout(20)
    stdscr.keypad(True)

    max_cava_rows = 8
    max_val = max_cava_rows * 8
    cava_cfg_path = create_cava_config(36, max_val)
    cava_proc = None
    try:
        cava_proc = subprocess.Popen(
            ["cava", "-p", cava_cfg_path],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
        )
        fd = cava_proc.stdout.fileno()
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl | os.O_NONBLOCK)
    except Exception:
        cava_proc = None

    blocks = [" ", " ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    last_values = [0] * 36

    vol, muted = get_audio_info()

    try:
        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()
            if h < 8 or w < 25:
                safe_addstr(stdscr, 0, 0, "Window too small!")
                stdscr.refresh()
                ch = stdscr.getch()
                if ch in (ord('q'), ord('Q'), 27):
                    break
                continue

            box_w = max(20, w - 4)

            # Header Box
            safe_addstr(stdscr, 1, 2, "+" + "-" * (box_w - 2) + "+", curses.color_pair(1))
            title = " AUDIO VOLUME CONTROL "
            safe_addstr(stdscr, 2, 2, f"|{title:^{box_w-2}}|", curses.color_pair(1) | curses.A_BOLD)
            safe_addstr(stdscr, 3, 2, "+" + "-" * (box_w - 2) + "+", curses.color_pair(1))

            # Status Line
            status_str = f" Volume: {vol}%   State: " + ("MUTED" if muted else "ACTIVE")
            safe_addstr(stdscr, 4, 3, status_str, curses.color_pair(1) | curses.A_BOLD)

            # Progress Bar
            bar_len = max(5, box_w - 6)
            filled = int((vol / 100.0) * bar_len)
            bar = "█" * filled + "░" * (bar_len - filled)
            safe_addstr(stdscr, 5, 3, f"[{bar}]", curses.color_pair(1))

            # Realtime CAVA Huge 8-Row Visualizer Box
            num_bars = max(8, min(36, box_w - 8))

            if cava_proc and cava_proc.stdout:
                try:
                    lines = cava_proc.stdout.read()
                    if lines:
                        latest_line = lines.strip().splitlines()[-1]
                        vals = [int(v) for v in latest_line.split(";") if v.isdigit()]
                        if vals:
                            last_values = vals
                except Exception:
                    pass

            start_y = 6
            safe_addstr(stdscr, start_y, 2, "+" + "-" * (box_w - 2) + "+", curses.color_pair(1))

            # Render 8 rows of vertical CAVA spectrum bars
            for r in range(max_cava_rows - 1, -1, -1):
                row_chars = []
                for v in last_values[:num_bars]:
                    cell_val = max(0, min(8, v - r * 8))
                    row_chars.append(blocks[cell_val])
                row_str = "".join(row_chars)
                safe_addstr(stdscr, start_y + (max_cava_rows - r), 2, f"|{row_str:^{box_w-2}}|", curses.color_pair(1) | curses.A_BOLD)

            safe_addstr(stdscr, start_y + max_cava_rows + 1, 2, "+" + "-" * (box_w - 2) + "+", curses.color_pair(1))

            stdscr.refresh()

            ch = stdscr.getch()
            if ch != -1:
                if ch in (ord('q'), ord('Q'), 27):
                    break
                elif ch in (curses.KEY_UP, ord('k'), ord('+'), ord('=')):
                    set_volume(vol + 5)
                    vol, muted = get_audio_info()
                elif ch in (curses.KEY_DOWN, ord('j'), ord('-')):
                    set_volume(vol - 5)
                    vol, muted = get_audio_info()
                elif ch in (ord('m'), ord('M')):
                    toggle_mute()
                    vol, muted = get_audio_info()
    finally:
        if cava_proc:
            cava_proc.terminate()
        if os.path.exists(cava_cfg_path):
            try:
                os.remove(cava_cfg_path)
            except Exception:
                pass

if __name__ == "__main__":
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        sys.exit(0)
