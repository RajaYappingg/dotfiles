#!/usr/bin/env python3
import curses
import subprocess
import sys
import time

def get_wifi_status():
    try:
        res = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True, check=True)
        return res.stdout.strip().lower() == "enabled"
    except Exception:
        return False

def get_wifi_networks():
    try:
        res = subprocess.run(
            ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"],
            capture_output=True, text=True, check=True
        )
        networks = []
        seen_ssids = set()
        for line in res.stdout.strip().split("\n"):
            if not line:
                continue
            parts = line.replace(r"\:", "__COLON__").split(":")
            parts = [p.replace("__COLON__", ":") for p in parts]
            if len(parts) >= 3:
                in_use = (parts[0] == "*")
                ssid = parts[1].strip()
                signal = parts[2].strip()
                security = parts[3].strip() if len(parts) > 3 else ""
                
                if not ssid:
                    continue
                
                if ssid not in seen_ssids or in_use:
                    seen_ssids.add(ssid)
                    networks.append({
                        "in_use": in_use,
                        "ssid": ssid,
                        "signal": signal,
                        "security": security
                    })
        networks.sort(key=lambda x: (not x["in_use"], -int(x["signal"]) if x["signal"].isdigit() else 0))
        return networks
    except Exception:
        return []

def connect_to_wifi(stdscr, ssid, security):
    curses.noecho()
    curses.curs_set(1)
    stdscr.clear()
    h, w = stdscr.getmaxyx()
    
    password = ""
    is_secured = security and security != "--" and security != ""
    
    if is_secured:
        stdscr.addstr(2, 3, f"Connect to: {ssid}", curses.A_BOLD)
        prompt = "Password (press Enter if saved): "
        stdscr.addstr(4, 3, prompt, curses.color_pair(1))
        
        start_y, start_x = 4, 3 + len(prompt)
        stdscr.move(start_y, start_x)
        stdscr.refresh()
        
        pass_chars = []
        while True:
            ch = stdscr.getch()
            if ch in (10, 13):
                break
            elif ch in (27,):
                curses.curs_set(0)
                return
            elif ch in (8, 127, curses.KEY_BACKSPACE):
                if pass_chars:
                    pass_chars.pop()
                    curr_y, curr_x = stdscr.getyx()
                    if curr_x > start_x:
                        stdscr.move(curr_y, curr_x - 1)
                        stdscr.delch()
            elif 32 <= ch <= 126:
                pass_chars.append(chr(ch))
                stdscr.addch('*')
            stdscr.refresh()
            
        password = "".join(pass_chars)
    
    curses.curs_set(0)
    stdscr.clear()
    stdscr.addstr(3, 3, f"Connecting to {ssid}...", curses.A_BOLD)
    stdscr.refresh()
    
    cmd = ["nmcli", "dev", "wifi", "connect", ssid]
    if password:
        cmd.extend(["password", password])
        
    res = subprocess.run(cmd, capture_output=True, text=True)
    stdscr.clear()
    if res.returncode == 0:
        stdscr.addstr(3, 3, f"✓ Successfully connected to {ssid}!", curses.A_BOLD)
    else:
        err = res.stderr.strip() or res.stdout.strip()
        stdscr.addstr(3, 3, f"✗ Connection failed: {err[:w-25]}", curses.A_BOLD)
    
    stdscr.addstr(5, 3, "Press any key to return...")
    stdscr.refresh()
    stdscr.getch()

def disconnect_wifi(stdscr):
    stdscr.clear()
    stdscr.addstr(3, 3, "Disconnecting Wi-Fi...", curses.A_BOLD)
    stdscr.refresh()
    subprocess.run(["nmcli", "dev", "disconnect", "wlan0"], capture_output=True)
    time.sleep(0.5)

def toggle_wifi(stdscr):
    current = get_wifi_status()
    target = "off" if current else "on"
    subprocess.run(["nmcli", "radio", "wifi", target], capture_output=True)
    time.sleep(0.5)

def main(stdscr):
    curses.use_default_colors()
    curses.curs_set(0)

    # Pure AMOLED Black & White Pairs
    curses.init_pair(1, curses.COLOR_WHITE, -1)                   # Normal White on Transparent
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)    # Selected (Black text on White)
    curses.init_pair(3, curses.COLOR_WHITE, -1)                   # Connected (Bold White)

    selected_idx = 0
    stdscr.nodelay(False)
    stdscr.keypad(True)

    networks = get_wifi_networks()

    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()
        if h < 10 or w < 30:
            stdscr.addstr(0, 0, "Terminal window too small!")
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord('q'), ord('Q'), 27):
                break
            continue

        wifi_enabled = get_wifi_status()

        # Header box in pure B&W
        stdscr.addstr(1, 2, "┌" + "─" * (w - 6) + "┐", curses.color_pair(1))
        title = " 󰤨  WIFI NETWORK MANAGER "
        stdscr.addstr(2, 2, f"│ {title:<{w-8}} │", curses.color_pair(1) | curses.A_BOLD)
        
        status_str = "Status: " + ("● ENABLED" if wifi_enabled else "○ DISABLED")
        stdscr.addstr(3, 2, "│ ", curses.color_pair(1))
        stdscr.addstr(status_str, curses.color_pair(1) | curses.A_BOLD)
        padding = w - 6 - len(status_str)
        stdscr.addstr(" " * padding + "│", curses.color_pair(1))
        stdscr.addstr(4, 2, "├" + "─" * (w - 6) + "┤", curses.color_pair(1))

        # Controls bar in pure B&W
        controls = "[Enter] Connect  │  [R]escan  │  [T]oggle  │  [D]isconnect  │  [Q]uit"
        stdscr.addstr(5, 2, f"│ {controls:^{w-8}} │", curses.color_pair(1))
        stdscr.addstr(6, 2, "├" + "─" * (w - 6) + "┤", curses.color_pair(1))

        # Network list area
        max_list_items = h - 9
        if max_list_items < 1:
            max_list_items = 1

        if not wifi_enabled:
            stdscr.addstr(8, 4, "Wi-Fi is currently disabled. Press [T] to enable.", curses.color_pair(1))
        elif not networks:
            stdscr.addstr(8, 4, "Searching for Wi-Fi networks...", curses.color_pair(1))
        else:
            if selected_idx >= len(networks):
                selected_idx = max(0, len(networks) - 1)

            start_idx = max(0, selected_idx - max_list_items + 1)
            end_idx = min(len(networks), start_idx + max_list_items)

            for i in range(start_idx, end_idx):
                net = networks[i]
                line_y = 7 + (i - start_idx)
                
                is_selected = (i == selected_idx)
                connected_mark = "● " if net["in_use"] else "  "
                ssid = net["ssid"]
                signal = net["signal"] + "%"
                sec = net["security"] or "Open"
                
                sig_val = int(net["signal"]) if net["signal"].isdigit() else 0
                if sig_val > 75:
                    sig_icon = "󰤨"
                elif sig_val > 50:
                    sig_icon = "󰤥"
                elif sig_val > 25:
                    sig_icon = "󰤢"
                else:
                    sig_icon = "󰤟"

                display_text = f"{connected_mark}{sig_icon} {ssid:<{w-36}} {signal:>4}  [{sec}]"
                display_text = display_text[:w-8]

                stdscr.addstr(line_y, 2, "│ ", curses.color_pair(1))
                if is_selected:
                    stdscr.addstr(f"{display_text:<{w-8}}", curses.color_pair(2) | curses.A_BOLD)
                else:
                    attr = curses.color_pair(3) | curses.A_BOLD if net["in_use"] else curses.color_pair(1)
                    stdscr.addstr(f"{display_text:<{w-8}}", attr)
                stdscr.addstr(" │", curses.color_pair(1))

        # Bottom Border
        stdscr.addstr(h - 2, 2, "└" + "─" * (w - 6) + "┘", curses.color_pair(1))
        stdscr.refresh()

        key = stdscr.getch()

        if key in (ord('q'), ord('Q'), 27):
            break
        elif key in (curses.KEY_UP, ord('k')):
            if selected_idx > 0:
                selected_idx -= 1
        elif key in (curses.KEY_DOWN, ord('j')):
            if networks and selected_idx < len(networks) - 1:
                selected_idx += 1
        elif key in (ord('r'), ord('R')):
            subprocess.run(["nmcli", "dev", "wifi", "rescan"], capture_output=True)
            networks = get_wifi_networks()
        elif key in (ord('t'), ord('T')):
            toggle_wifi(stdscr)
            networks = get_wifi_networks()
        elif key in (ord('d'), ord('D')):
            disconnect_wifi(stdscr)
            networks = get_wifi_networks()
        elif key in (10, 13, curses.KEY_ENTER):
            if networks and 0 <= selected_idx < len(networks):
                target = networks[selected_idx]
                connect_to_wifi(stdscr, target["ssid"], target["security"])
                networks = get_wifi_networks()

if __name__ == "__main__":
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        sys.exit(0)
