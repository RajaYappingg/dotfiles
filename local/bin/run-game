#!/bin/bash
# Wrapper to launch any game with NVIDIA RTX 3050 & GameMode

export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

# Turn on Game Mode
/home/zaki/.local/bin/game-mode

# Execute requested app/game
if [ $# -gt 0 ]; then
    "$@"
fi
