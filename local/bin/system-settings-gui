_fan_hwmon_cache = None

def find_fan_hwmon():
    global _fan_hwmon_cache
    if _fan_hwmon_cache and os.path.exists(_fan_hwmon_cache):
        return _fan_hwmon_cache

    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        name_path = os.path.join(h, "name")
        if os.path.exists(name_path):
            try:
                with open(name_path, "r") as f:
                    name = f.read().strip().lower()
                if "acer" in name or os.path.exists(os.path.join(h, "pwm1")):
                    _fan_hwmon_cache = h
                    return h
            except Exception:
                pass
    return None

def get_fan_status():
    hwmon = find_fan_hwmon()
    if not hwmon:
        return {
            "cpu_rpm": 0, "cpu_percent": 0, "cpu_auto": True,
            "gpu_rpm": 0, "gpu_percent": 0, "gpu_auto": True,
            "available": False
        }

    res = {
        "cpu_rpm": 0, "cpu_percent": 0, "cpu_auto": True,
        "gpu_rpm": 0, "gpu_percent": 0, "gpu_auto": True,
        "available": True
    }

    try:
        f1 = os.path.join(hwmon, "fan1_input")
        if os.path.exists(f1):
            with open(f1, "r") as f:
                res["cpu_rpm"] = int(f.read().strip())

        p1 = os.path.join(hwmon, "pwm1")
        if os.path.exists(p1):
            with open(p1, "r") as f:
                pwm = int(f.read().strip())
                res["cpu_percent"] = int(round(pwm / 255.0 * 100))

        pe1 = os.path.join(hwmon, "pwm1_enable")
        if os.path.exists(pe1):
            with open(pe1, "r") as f:
                mode = int(f.read().strip())
                res["cpu_auto"] = (mode == 2)

        f2 = os.path.join(hwmon, "fan2_input")
        if os.path.exists(f2):
            with open(f2, "r") as f:
                res["gpu_rpm"] = int(f.read().strip())

        p2 = os.path.join(hwmon, "pwm2")
        if os.path.exists(p2):
            with open(p2, "r") as f:
                pwm = int(f.read().strip())
                res["gpu_percent"] = int(round(pwm / 255.0 * 100))

        pe2 = os.path.join(hwmon, "pwm2_enable")
        if os.path.exists(pe2):
            with open(pe2, "r") as f:
                mode = int(f.read().strip())
                res["gpu_auto"] = (mode == 2)
    except Exception:
        pass

    return res

def set_fan_control(fan_type, percent=None, auto=False):
    hwmon = find_fan_hwmon()
    if not hwmon:
        return

    pwm_num = "1" if fan_type == "cpu" else "2"
    pwm_file = os.path.join(hwmon, f"pwm{pwm_num}")
    enable_file = os.path.join(hwmon, f"pwm{pwm_num}_enable")

    commands = []
    if auto:
        commands.append((enable_file, "2"))
    else:
        if percent is not None:
            pwm_val = str(max(0, min(255, int(round(percent * 2.55)))))
            commands.append((enable_file, "1"))
            commands.append((pwm_file, pwm_val))

    for path, val in commands:
        if not os.path.exists(path):
            continue
        try:
            with open(path, "w") as f:
                f.write(val)
        except PermissionError:
            try:
                subprocess.run(["sudo", "-n", "/home/zaki/.local/bin/setup-fan-permissions"], timeout=2)
                with open(path, "w") as f:
                    f.write(val)
            except Exception:
                try:
                    subprocess.run(["pkexec", "sh", "-c", f"chmod 0666 {hwmon}/pwm*"], timeout=5)
                    with open(path, "w") as f:
                        f.write(val)
                except Exception:
                    pass
        except Exception:
            pass

