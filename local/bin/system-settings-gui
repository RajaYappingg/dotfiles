    def refresh_wifi_list(self):
        networks = []
        try:
            res = subprocess.run(
                ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"],
                capture_output=True, text=True, timeout=4
            )
            seen_ssids = set()
            for line in res.stdout.strip().split("\n"):
                if not line:
                    continue
                parts = line.replace(r"\:", "__COLON__").split(":")
                parts = [p.replace("__COLON__", ":") for p in parts]
                if len(parts) >= 3:
                    in_use = (parts[0] == "*")
                    ssid = parts[1].strip()
                    signal = parts[2].strip()
                    security = parts[3].strip() if len(parts) > 3 else ""
                    if ssid and (ssid not in seen_ssids or in_use):
                        seen_ssids.add(ssid)
                        networks.append({"in_use": in_use, "ssid": ssid, "signal": signal, "security": security})
            networks.sort(key=lambda x: (not x["in_use"], -int(x["signal"]) if x["signal"].isdigit() else 0))
        except Exception:
            pass

        GLib.idle_add(self._render_wifi_items, networks)

    def _render_wifi_items(self, networks):
        for child in self.wifi_list_vbox.get_children():
            self.wifi_list_vbox.remove(child)

        if not networks:
            empty_lbl = Gtk.Label(label="No Wi-Fi networks found.")
            empty_lbl.get_style_context().add_class("setting-desc")
            self.wifi_list_vbox.pack_start(empty_lbl, False, False, 0)
        else:
            for net in networks[:6]:
                outer_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                outer_vbox.get_style_context().add_class("wifi-row-item")

                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

                icon_str = "󰤨" if net["in_use"] else "󰤢"
                lbl_icon = Gtk.Label()
                lbl_icon.set_markup(f"<span foreground='{ '#38bdf8' if net['in_use'] else '#64748b' }' font='14'>{icon_str}</span>")
                row.pack_start(lbl_icon, False, False, 0)

                vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                
                title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                lbl_ssid = Gtk.Label(label=net["ssid"])
                lbl_ssid.set_halign(Gtk.Align.START)
                lbl_ssid.get_style_context().add_class("setting-title")
                title_box.pack_start(lbl_ssid, False, False, 0)

                if net["in_use"]:
                    badge = Gtk.Label(label="Connected")
                    badge.get_style_context().add_class("connected-badge")
                    badge.set_valign(Gtk.Align.CENTER)
                    title_box.pack_start(badge, False, False, 0)

                lbl_sub = Gtk.Label(label=f"Signal: {net['signal']}%  •  Security: {net['security'] or 'Open'}")
                lbl_sub.set_halign(Gtk.Align.START)
                lbl_sub.get_style_context().add_class("setting-desc")

                vbox.pack_start(title_box, False, False, 0)
                vbox.pack_start(lbl_sub, False, False, 0)
                row.pack_start(vbox, True, True, 0)

                # Expandable password entry box (Inline)
                pass_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                pass_box.set_margin_top(6)
                pass_box.set_margin_bottom(6)

                pass_entry = Gtk.Entry()
                pass_entry.set_visibility(False)
                pass_entry.set_placeholder_text("Enter Wi-Fi password...")
                pass_entry.get_style_context().add_class("wifi-pass-entry")
                pass_entry.connect("activate", lambda e, s=net["ssid"], pb=pass_box: self.on_inline_join_clicked(s, e, pb))
                pass_box.pack_start(pass_entry, True, True, 0)

                btn_submit = Gtk.Button(label="Join")
                btn_submit.get_style_context().add_class("blue-action-btn")
                btn_submit.connect("clicked", lambda b, s=net["ssid"], e=pass_entry, pb=pass_box: self.on_inline_join_clicked(s, e, pb))
                pass_box.pack_start(btn_submit, False, False, 0)

                if net["in_use"]:
                    chk_btn = Gtk.Label(label="✓")
                    chk_btn.get_style_context().add_class("connected-badge")
                    chk_btn.set_valign(Gtk.Align.CENTER)
                    row.pack_end(chk_btn, False, False, 0)
                else:
                    btn_conn = Gtk.Button(label="Connect")
                    btn_conn.get_style_context().add_class("outline-btn")
                    btn_conn.connect("clicked", lambda b, pb=pass_box, e=pass_entry, s=net["ssid"], sec=net["security"]: self.handle_connect_click(s, sec, pb, e))
                    row.pack_end(btn_conn, False, False, 0)

                chev = Gtk.Label(label="›")
                chev.get_style_context().add_class("setting-desc")
                chev.set_valign(Gtk.Align.CENTER)
                row.pack_end(chev, False, False, 0)

                outer_vbox.pack_start(row, False, False, 0)
                outer_vbox.pack_start(pass_box, False, False, 0)

                self.wifi_list_vbox.pack_start(outer_vbox, False, False, 0)

        self.wifi_list_vbox.show_all()
        # Initially hide all password boxes after show_all
        for child in self.wifi_list_vbox.get_children():
            # child is outer_vbox
            children = child.get_children()
            if len(children) > 1:
                children[1].hide()

    def handle_connect_click(self, ssid, security, pass_box, pass_entry):
        is_secured = security and security != "--" and security != ""
        if not is_secured:
            threading.Thread(target=self._do_wifi_connect, args=(ssid, None), daemon=True).start()
        else:
            if pass_box.is_visible():
                pass_box.hide()
            else:
                pass_box.show()
                pass_box.show_all()
                pass_entry.grab_focus()

    def on_inline_join_clicked(self, ssid, pass_entry, pass_box):
        password = pass_entry.get_text().strip()
        pass_box.hide()
        threading.Thread(target=self._do_wifi_connect, args=(ssid, password if password else None), daemon=True).start()

    def _do_wifi_connect(self, ssid, password):
        cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        if password:
            cmd.extend(["password", password])
        subprocess.run(cmd, capture_output=True, text=True)
        time.sleep(1)
        self.refresh_wifi_list()

    def refresh_bt_list(self):
        devices = []
        try:
            res = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True, timeout=3)
            for line in res.stdout.strip().split("\n"):
                if line.startswith("Device "):
                    parts = line.split(" ", 2)
                    if len(parts) >= 3:
                        devices.append({"mac": parts[1], "name": parts[2]})
        except Exception:
            pass

        GLib.idle_add(self._render_bt_items, devices)

    def _render_bt_items(self, devices):
        for child in self.bt_list_vbox.get_children():
            self.bt_list_vbox.remove(child)

        if not devices:
            empty_lbl = Gtk.Label(label="No paired Bluetooth devices found.")
            empty_lbl.get_style_context().add_class("setting-desc")
            self.bt_list_vbox.pack_start(empty_lbl, False, False, 0)
        else:
            for dev in devices[:5]:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.get_style_context().add_class("wifi-row-item")

                lbl_icon = Gtk.Label()
                lbl_icon.set_markup("<span foreground='#64748b' font='14'>󰂯</span>")
                row.pack_start(lbl_icon, False, False, 0)

                vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                lbl_name = Gtk.Label(label=dev["name"])
                lbl_name.set_halign(Gtk.Align.START)
                lbl_name.get_style_context().add_class("setting-title")

                lbl_mac = Gtk.Label(label=f"MAC: {dev['mac']}")
                lbl_mac.set_halign(Gtk.Align.START)
                lbl_mac.get_style_context().add_class("setting-desc")

                vbox.pack_start(lbl_name, False, False, 0)
                vbox.pack_start(lbl_mac, False, False, 0)
                row.pack_start(vbox, True, True, 0)

                btn_conn = Gtk.Button(label="Connect")
                btn_conn.get_style_context().add_class("outline-btn")
                btn_conn.connect("clicked", lambda b, m=dev["mac"]: subprocess.Popen(["bluetoothctl", "connect", m]))
                row.pack_end(btn_conn, False, False, 0)

                chev = Gtk.Label(label="›")
                chev.get_style_context().add_class("setting-desc")
                chev.set_valign(Gtk.Align.CENTER)
                row.pack_end(chev, False, False, 0)

                self.bt_list_vbox.pack_start(row, False, False, 0)

        self.bt_list_vbox.show_all()

    def build_cooling_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        lbl_sec = Gtk.Label(label="󰈐  Cooling & Fan Speed")
        lbl_sec.set_halign(Gtk.Align.START)
        lbl_sec.get_style_context().add_class("section-header")
        box.pack_start(lbl_sec, False, False, 0)

        fan_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        fan_card.get_style_context().add_class("group-card")

        # Row 1: CPU Fan
        cpu_fan_hdr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_cpu_title = Gtk.Label()
        lbl_cpu_title.set_markup("<span foreground='#38bdf8' font='12'><b>CPU Fan Speed</b></span>")
        lbl_cpu_title.set_halign(Gtk.Align.START)

        self.lbl_cpu_rpm = Gtk.Label(label="-- RPM")
        self.lbl_cpu_rpm.get_style_context().add_class("setting-desc")
        self.lbl_cpu_rpm.set_halign(Gtk.Align.START)

        cpu_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

        self.btn_cpu_auto = Gtk.Button(label="AUTO")
        self.btn_cpu_auto.get_style_context().add_class("fan-auto-btn")
        self.btn_cpu_auto.connect("clicked", self.on_cpu_auto_clicked)

        self.btn_cpu_max = Gtk.Button(label="MAX")
        self.btn_cpu_max.get_style_context().add_class("fan-max-btn")
        self.btn_cpu_max.connect("clicked", self.on_cpu_max_clicked)

        cpu_btn_box.pack_start(self.btn_cpu_auto, False, False, 0)
        cpu_btn_box.pack_start(self.btn_cpu_max, False, False, 0)

        cpu_fan_hdr_box.pack_start(lbl_cpu_title, False, False, 0)
        cpu_fan_hdr_box.pack_start(self.lbl_cpu_rpm, True, True, 0)
        cpu_fan_hdr_box.pack_end(cpu_btn_box, False, False, 0)

        cpu_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl_cpu_icon = Gtk.Label()
        lbl_cpu_icon.set_markup("<span foreground='#38bdf8' font='14'>󰈐</span>")

        self.scale_cpu_fan = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_cpu_fan.set_draw_value(False)
        self.scale_cpu_fan.connect("value-changed", self.on_cpu_fan_slider_changed)

        self.lbl_cpu_fan_val = Gtk.Label(label="Auto")
        self.lbl_cpu_fan_val.set_halign(Gtk.Align.END)
        self.lbl_cpu_fan_val.get_style_context().add_class("setting-desc")

        cpu_box.pack_start(lbl_cpu_icon, False, False, 0)
        cpu_box.pack_start(self.scale_cpu_fan, True, True, 0)
        cpu_box.pack_start(self.lbl_cpu_fan_val, False, False, 0)

        fan_card.pack_start(cpu_fan_hdr_box, False, False, 0)
        fan_card.pack_start(cpu_box, False, False, 0)

        # Separator line
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        fan_card.pack_start(sep, False, False, 0)

        # Row 2: GPU Fan
        gpu_fan_hdr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_gpu_title = Gtk.Label()
        lbl_gpu_title.set_markup("<span foreground='#f87171' font='12'><b>GPU Fan Speed</b></span>")
        lbl_gpu_title.set_halign(Gtk.Align.START)

        self.lbl_gpu_rpm = Gtk.Label(label="-- RPM")
        self.lbl_gpu_rpm.get_style_context().add_class("setting-desc")
        self.lbl_gpu_rpm.set_halign(Gtk.Align.START)

        gpu_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

        self.btn_gpu_auto = Gtk.Button(label="AUTO")
        self.btn_gpu_auto.get_style_context().add_class("fan-auto-btn")
        self.btn_gpu_auto.connect("clicked", self.on_gpu_auto_clicked)

        self.btn_gpu_max = Gtk.Button(label="MAX")
        self.btn_gpu_max.get_style_context().add_class("fan-max-btn")
        self.btn_gpu_max.connect("clicked", self.on_gpu_max_clicked)

        gpu_btn_box.pack_start(self.btn_gpu_auto, False, False, 0)
        gpu_btn_box.pack_start(self.btn_gpu_max, False, False, 0)

        gpu_fan_hdr_box.pack_start(lbl_gpu_title, False, False, 0)
        gpu_fan_hdr_box.pack_start(self.lbl_gpu_rpm, True, True, 0)
        gpu_fan_hdr_box.pack_end(gpu_btn_box, False, False, 0)

        gpu_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
