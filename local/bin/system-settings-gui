        self.switch_category(0)

    def switch_category(self, idx):
        for i, btn in enumerate(self.cat_buttons):
            if i == idx:
                btn.get_style_context().add_class("active")
            else:
                btn.get_style_context().remove_class("active")

        child = self.content_scrolled.get_child()
        if child:
            self.content_scrolled.remove(child)

        _, _, builder_fn = self.categories[idx]
        page_box = builder_fn()
        page_box.get_style_context().add_class("content-area")
        self.content_scrolled.add(page_box)
        self.content_scrolled.show_all()



