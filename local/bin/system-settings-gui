        self.scale_gpu_fan = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_gpu_fan.set_draw_value(False)
        self.scale_gpu_fan.connect("value-changed", self.on_gpu_fan_slider_changed)

        self.lbl_gpu_fan_val = Gtk.Label(label="Auto")
        self.lbl_gpu_fan_val.set_halign(Gtk.Align.END)
        self.lbl_gpu_fan_val.get_style_context().add_class("setting-desc")

        gpu_box.pack_start(lbl_gpu_icon, False, False, 0)
        gpu_box.pack_start(self.scale_gpu_fan, True, True, 0)
        gpu_box.pack_start(self.lbl_gpu_fan_val, False, False, 0)

        fan_card.pack_start(gpu_fan_hdr_box, False, False, 0)
        fan_card.pack_start(gpu_box, False, False, 0)

        box.pack_start(fan_card, False, False, 0)

        # Extra button to open standalone cooling app
        btn_cool = Gtk.Button(label="Open Standalone Predator Cooling GUI")
        btn_cool.get_style_context().add_class("blue-action-btn")
        btn_cool.connect("clicked", lambda b: subprocess.Popen(["/home/zaki/.local/bin/cooling"]))
        box.pack_start(btn_cool, False, False, 0)

        # Trigger initial UI update
        self.update_fan_ui()
        return box

    def on_cpu_fan_slider_changed(self, scale):
        if getattr(self, "_updating_sliders", False):
            return
        val = int(scale.get_value())
        self.lbl_cpu_fan_val.set_text(f"{val}%")
        self.btn_cpu_auto.get_style_context().remove_class("active-auto")
        if val >= 99:
            self.btn_cpu_max.get_style_context().add_class("active-max")
        else:
            self.btn_cpu_max.get_style_context().remove_class("active-max")
        set_fan_control("cpu", percent=val, auto=False)

    def on_gpu_fan_slider_changed(self, scale):
        if getattr(self, "_updating_sliders", False):
            return
        val = int(scale.get_value())
        self.lbl_gpu_fan_val.set_text(f"{val}%")
        self.btn_gpu_auto.get_style_context().remove_class("active-auto")
        if val >= 99:
            self.btn_gpu_max.get_style_context().add_class("active-max")
        else:
            self.btn_gpu_max.get_style_context().remove_class("active-max")
        set_fan_control("gpu", percent=val, auto=False)

    def on_cpu_auto_clicked(self, btn):
        set_fan_control("cpu", auto=True)
        self.update_fan_ui()

    def on_gpu_auto_clicked(self, btn):
        set_fan_control("gpu", auto=True)
        self.update_fan_ui()

    def on_cpu_max_clicked(self, btn):
        set_fan_control("cpu", percent=100, auto=False)
        self.update_fan_ui()

    def on_gpu_max_clicked(self, btn):
        set_fan_control("gpu", percent=100, auto=False)
        self.update_fan_ui()

    def update_fan_ui(self):
        status = get_fan_status()
        if not status["available"]:
            return

        self._updating_sliders = True
        try:
            if status["cpu_rpm"] > 0:
                self.lbl_cpu_rpm.set_text(f"{status['cpu_rpm']} RPM")
            else:
                self.lbl_cpu_rpm.set_text("0 RPM")

            if status["cpu_auto"]:
                self.btn_cpu_auto.get_style_context().add_class("active-auto")
                self.btn_cpu_max.get_style_context().remove_class("active-max")
                self.scale_cpu_fan.set_value(status["cpu_percent"])
                self.lbl_cpu_fan_val.set_text("Auto")
            else:
                self.btn_cpu_auto.get_style_context().remove_class("active-auto")
                self.scale_cpu_fan.set_value(status["cpu_percent"])
                self.lbl_cpu_fan_val.set_text(f"{status['cpu_percent']}%")
                if status["cpu_percent"] >= 99:
                    self.btn_cpu_max.get_style_context().add_class("active-max")
                else:
                    self.btn_cpu_max.get_style_context().remove_class("active-max")

            if status["gpu_rpm"] > 0:
                self.lbl_gpu_rpm.set_text(f"{status['gpu_rpm']} RPM")
            else:
                self.lbl_gpu_rpm.set_text("0 RPM")

            if status["gpu_auto"]:
                self.btn_gpu_auto.get_style_context().add_class("active-auto")
                self.btn_gpu_max.get_style_context().remove_class("active-max")
                self.scale_gpu_fan.set_value(status["gpu_percent"])
                self.lbl_gpu_fan_val.set_text("Auto")
            else:
                self.btn_gpu_auto.get_style_context().remove_class("active-auto")
                self.scale_gpu_fan.set_value(status["gpu_percent"])
                self.lbl_gpu_fan_val.set_text(f"{status['gpu_percent']}%")
                if status["gpu_percent"] >= 99:
                    self.btn_gpu_max.get_style_context().add_class("active-max")
                else:
                    self.btn_gpu_max.get_style_context().remove_class("active-max")
        finally:
            self._updating_sliders = False



    def load_wallpaper_thumbnail(self, gtk_image):
        try:
            wallpapers = glob.glob("/home/zaki/Pictures/wallpapers/*") + glob.glob("/home/zaki/Pictures/*")
            if wallpapers:
                path = wallpapers[0]
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 240, 135, True)
                gtk_image.set_from_pixbuf(pixbuf)
        except Exception:
            pass

    def on_draw(self, widget, cr):
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        return False

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

if __name__ == "__main__":
    css_provider = Gtk.CssProvider()
    css_provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        css_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    app = IllogicalSettingsApp()
    app.show_all()
    Gtk.main()
