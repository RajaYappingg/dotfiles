class IllogicalSettingsApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Settings")
        self.set_name("illogical-settings")
        self.set_wmclass("floating_sys_settings", "floating_sys_settings")
        
        self.set_default_size(860, 580)
        self.set_size_request(760, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)

        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.connect("draw", self.on_draw)
        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", Gtk.main_quit)

        outer_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer_box.get_style_context().add_class("outer-window-box")
        self.add(outer_box)

        # 1. Top Header
        top_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        top_header.get_style_context().add_class("top-header")

        btn_sidebar_toggle = Gtk.Button(label="󰍜")
        btn_sidebar_toggle.get_style_context().add_class("header-icon-btn")

        title_lbl = Gtk.Label(label="Settings")
        title_lbl.get_style_context().add_class("top-header-title")
        title_lbl.set_halign(Gtk.Align.CENTER)

        btn_search = Gtk.Button(label="󰍉")
        btn_search.get_style_context().add_class("header-icon-btn")

        top_header.pack_start(btn_sidebar_toggle, False, False, 0)
        top_header.pack_start(title_lbl, True, True, 0)
        top_header.pack_end(btn_search, False, False, 0)
        outer_box.pack_start(top_header, False, False, 0)

        # 2. Main Content HBox (Sidebar + Right Content)
        main_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        outer_box.pack_start(main_hbox, True, True, 0)

        # Sidebar
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        sidebar.set_size_request(220, -1)
        sidebar.get_style_context().add_class("sidebar-box")

        self.categories = [
            ("󰒓", "Quick", self.build_quick_settings),
            ("󰍹", "Bar & screen", self.build_bar_screen),
            ("󰕾", "Audio & Sound", self.build_audio_page),
            ("󰤨", "Network & Wi-Fi", self.build_network_page),
            ("󰈐", "Cooling & Fans", self.build_cooling_page),
        ]

        self.cat_buttons = []
        for idx, (icon_char, title, builder_fn) in enumerate(self.categories):
            btn = Gtk.Button()
            btn.get_style_context().add_class("side-tab-btn")
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            btn_box.set_halign(Gtk.Align.START)

            lbl_icon = Gtk.Label(label=icon_char)
            lbl_title = Gtk.Label(label=title)
            btn_box.pack_start(lbl_icon, False, False, 0)
            btn_box.pack_start(lbl_title, False, False, 0)

            btn.add(btn_box)
            btn.connect("clicked", lambda b, i=idx: self.switch_category(i))
            sidebar.pack_start(btn, False, False, 0)
            self.cat_buttons.append(btn)

        # Spacer in sidebar
        spacer = Gtk.Box()
        sidebar.pack_start(spacer, True, True, 0)

        # User Profile Footer Card
        user_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        user_card.get_style_context().add_class("user-profile-card")

        user_avatar = Gtk.Label(label="👤")
        user_info_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        lbl_uname = Gtk.Label(label="Muhammad Izzuddin Zaki")
        lbl_uname.set_halign(Gtk.Align.START)
        lbl_uname.get_style_context().add_class("user-name-lbl")

        lbl_usub = Gtk.Label(label="m.zaki@example.com")
