        self.lbl_right_temp.get_style_context().add_class("right-temp-main")

        self.lbl_right_desc = Gtk.Label(label="Fetching Weather...")
        self.lbl_right_desc.get_style_context().add_class("right-desc-sub")

        temp_box.pack_start(self.lbl_right_temp, False, False, 0)
        temp_box.pack_start(self.lbl_right_desc, False, False, 0)

        # Bottom 4 Small Metrics Row
        metrics_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        metrics_row.set_halign(Gtk.Align.CENTER)
        metrics_row.set_margin_top(26)

        self.m_wind = MiniMetricMeter("󰖝", "WIND")
        self.m_humid = MiniMetricMeter("󰖎", "HUMID")
        self.m_rain = MiniMetricMeter("󰖗", "RAIN")
        self.m_feels = MiniMetricMeter("󰔏", "FEELS")

        metrics_row.pack_start(self.m_wind, True, True, 0)
        metrics_row.pack_start(self.m_humid, True, True, 0)
        metrics_row.pack_start(self.m_rain, True, True, 0)
        metrics_row.pack_start(self.m_feels, True, True, 0)

        right_box.pack_start(right_hdr, False, False, 0)
        right_box.pack_start(temp_box, False, False, 0)
        right_box.pack_start(metrics_row, False, False, 0)

        # Pack 3 columns into main panel
        self.panel.pack_start(left_box, False, False, 0)
        self.panel.pack_start(self.orbit_clock, True, True, 0)
        self.panel.pack_start(right_box, False, False, 0)

        self.add(self.panel)

        self.render_calendar()
        self.update_clock_realtime()

        # Fetch Weather in background thread
        threading.Thread(target=self.fetch_weather_async, daemon=True).start()

        # Animation state
        self.start_time = time.time()
        self.is_closing = False
        self.close_time = 0
        self.set_opacity(0.0)

        self.show_all()
        GLib.timeout_add(16, self.on_animation_frame)
        GLib.timeout_add_seconds(1, self.periodic_clock_tick)

    def render_calendar(self):
        m_name = calendar.month_name[self.curr_month].upper()
        self.lbl_month_hdr.set_text(f"{m_name} {self.curr_year}")

        for child in self.grid.get_children():
            self.grid.remove(child)

        weekdays = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
        for col, w_name in enumerate(weekdays):
            lbl = Gtk.Label(label=w_name)
            lbl.get_style_context().add_class("weekday-lbl")
            if col == 6:  # Sunday
                lbl.get_style_context().add_class("sunday")
            self.grid.attach(lbl, col, 0, 1, 1)

        cal = calendar.Calendar(firstweekday=0)
        month_days = cal.monthdayscalendar(self.curr_year, self.curr_month)

        month_holidays = []

        row = 1
        for week in month_days:
            for col, day in enumerate(week):
                if day == 0:
                    lbl = Gtk.Label(label="")
                    lbl.get_style_context().add_class("day-num")
                    lbl.get_style_context().add_class("day-other-m")
                    self.grid.attach(lbl, col, row, 1, 1)
                else:
                    lbl = Gtk.Label(label=str(day))
                    lbl.get_style_context().add_class("day-num")

                    is_sunday = (col == 6)
                    h_name = get_indonesia_holiday(self.curr_year, self.curr_month, day)

                    if is_sunday or h_name:
                        lbl.get_style_context().add_class("day-red")

                    if h_name:
                        lbl.set_tooltip_text(f"{day} {m_name}: {h_name}")
                        month_holidays.append(f"{day} {m_name[:3]}: {h_name}")
                    elif is_sunday:
                        lbl.set_tooltip_text(f"{day} {m_name}: Hari Minggu")

                    is_today = (self.curr_year == self.today_year and self.curr_month == self.today_month and day == self.today_day)
                    if is_today:
                        lbl.get_style_context().add_class("day-today-pill")

                    self.grid.attach(lbl, col, row, 1, 1)
            row += 1

        if month_holidays:
            self.lbl_holiday_notice.set_text(f"🇮🇩 {month_holidays[0]}")
            self.lbl_holiday_notice.set_tooltip_text("\n".join(month_holidays))
        else:
            self.lbl_holiday_notice.set_text("")

        self.grid.show_all()

    def update_clock_realtime(self):
        t = time.localtime()
        self.orbit_clock.lbl_clock_hm.set_text(time.strftime("%H:%M", t))
        self.orbit_clock.lbl_clock_sec.set_text(time.strftime(":%S", t))
        self.orbit_clock.lbl_date_sub.set_text(time.strftime("%A, %b %d", t))
        self.orbit_clock.lbl_cap_time.set_text(time.strftime("%H:%M", t))
        self.lbl_right_day.set_text(time.strftime("%A", t).upper())

    def periodic_clock_tick(self):
        if not self.is_closing:
            self.update_clock_realtime()
            return True
        return False

    def fetch_weather_async(self):
        try:
            req = urllib.request.Request("https://wttr.in/Magelang,Indonesia?format=j1", headers={"User-Agent": "curl/7.68.0"})
            with urllib.request.urlopen(req, timeout=4) as r:
                data = json.loads(r.read().decode())
                curr = data["current_condition"][0]

                temp_c = curr.get("temp_C", "0")
                feels_c = curr.get("FeelsLikeC", "0")
                humid = curr.get("humidity", "0")
                wind_k = curr.get("windspeedKmph", "0")
                desc = curr.get("weatherDesc", [{}])[0].get("value", "Clear")

                GLib.idle_add(self.apply_weather_data, temp_c, feels_c, humid, wind_k, desc)
        except Exception:
            GLib.idle_add(self.apply_weather_data, "26", "29", "75", "10", "Clear")

    def apply_weather_data(self, temp, feels, humid, wind, desc):
        self.lbl_right_temp.set_text(f"{temp}°")
        self.lbl_right_desc.set_text(desc)
        self.orbit_clock.lbl_cap_temp.set_text(f"{temp}°C")

        self.m_wind.set_data(f"{wind}k", min(100, int(float(wind)*2)))
        self.m_humid.set_data(f"{humid}%", int(float(humid)))
        self.m_rain.set_data("0%", 0)
        self.m_feels.set_data(f"{feels}°", min(100, int(float(feels)*2.5)))

    def on_prev_month(self, widget):
        if self.curr_month == 1:
            self.curr_month = 12
            self.curr_year -= 1
        else:
            self.curr_month -= 1
        self.render_calendar()

    def on_next_month(self, widget):
        if self.curr_month == 12:
            self.curr_month = 1
            self.curr_year += 1
        else:
            self.curr_month += 1
        self.render_calendar()

    def on_goto_today(self, widget):
        self.curr_year = self.today_year
        self.curr_month = self.today_month
        self.render_calendar()

    def close_window(self):
        if not self.is_closing:
            self.is_closing = True
            self.close_time = time.time()

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.close_window()
            return True
        return False

    def on_animation_frame(self):
        now = time.time()
        if not self.is_closing:
            elapsed = now - self.start_time
            if elapsed < 0.25:
                progress = ease_out_cubic(elapsed / 0.25)
                self.set_opacity(progress)
                margin = int(20 + (18 * progress))
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, margin)
                return True
            else:
                self.set_opacity(1.0)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 38)
                return True
        else:
            c_elapsed = now - self.close_time
            if c_elapsed < 0.20:
                progress = 1.0 - ease_in_cubic(c_elapsed / 0.20)
                self.set_opacity(progress)
                return True
            else:
                self.set_opacity(0.0)
                Gtk.main_quit()
                return False


def main():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 15)
            os.remove(PID_FILE)
            return
        except Exception:
            pass

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    try:
        app = AestheticCalendarDashboard()
        Gtk.main()
    finally:
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass


if __name__ == "__main__":
    main()
