def ease_out_cubic(t):
    t = max(0.0, min(1.0, t))
    return 1.0 - math.pow(1.0 - t, 3)

def ease_in_cubic(t):
    t = max(0.0, min(1.0, t))
    return t * t * t


class OrbitClockArea(Gtk.Overlay):
    def __init__(self):
        super().__init__()
        self.da = Gtk.DrawingArea()
        self.da.set_size_request(360, 270)
        self.da.connect("draw", self.on_draw_orbit)
        self.add(self.da)

        # Content Box overlay on top of orbit drawing
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        content.set_valign(Gtk.Align.CENTER)
        content.set_halign(Gtk.Align.CENTER)

        # Giant Clock Box (HH:MM + :SS)
        clock_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        clock_row.set_halign(Gtk.Align.CENTER)

        self.lbl_clock_hm = Gtk.Label(label="12:00")
        self.lbl_clock_hm.get_style_context().add_class("clock-main-text")

        self.lbl_clock_sec = Gtk.Label(label=":00")
        self.lbl_clock_sec.get_style_context().add_class("clock-sec-text")
        self.lbl_clock_sec.set_valign(Gtk.Align.CENTER)

        clock_row.pack_start(self.lbl_clock_hm, False, False, 0)
        clock_row.pack_start(self.lbl_clock_sec, False, False, 0)

        # Subtitle Full Date
        self.lbl_date_sub = Gtk.Label(label="Friday, May 08")
        self.lbl_date_sub.get_style_context().add_class("clock-date-sub")

        # Weather Capsule Pill Widget
        capsule = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        capsule.get_style_context().add_class("weather-capsule")
        capsule.set_halign(Gtk.Align.CENTER)

        self.lbl_cap_time = Gtk.Label(label="00:00")
        self.lbl_cap_time.get_style_context().add_class("capsule-time")

        self.lbl_cap_icon = Gtk.Label(label="󰖐")
        self.lbl_cap_icon.get_style_context().add_class("capsule-icon")

        self.lbl_cap_temp = Gtk.Label(label="0.0°")
        self.lbl_cap_temp.get_style_context().add_class("capsule-temp")

        capsule.pack_start(self.lbl_cap_time, False, False, 0)
        capsule.pack_start(self.lbl_cap_icon, False, False, 0)
        capsule.pack_start(self.lbl_cap_temp, False, False, 0)

        content.pack_start(clock_row, False, False, 0)
        content.pack_start(self.lbl_date_sub, False, False, 0)
        content.pack_start(capsule, False, False, 0)

        self.add_overlay(content)

        # 60 FPS Orbit Rotation Animation
        GLib.timeout_add(16, self.animate_orbit_frame)

    def animate_orbit_frame(self):
        self.da.queue_draw()
        return True

    def on_draw_orbit(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        xc, yc = w / 2, h / 2 - 12

        # Draw smooth animated rotating dashed ellipse orbit ring (Synchronized with real-time earth rotation)
        cr.save()
        cr.translate(xc, yc)
        cr.scale(1.42, 0.72)

        # Rotate continuously according to real-time (0.12 rad/sec)
        angle = (time.time() * 0.12) % (2 * math.pi)
        cr.rotate(angle)

        cr.set_dash([5.0, 7.0])
        cr.set_line_width(2.0)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.28)
        cr.arc(0, 0, 108, 0, 2 * math.pi)
        cr.stroke()
        cr.restore()


class MiniMetricMeter(Gtk.Box):
    def __init__(self, icon_str, title_str):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.icon_str = icon_str
        self.title_str = title_str

        self.da = Gtk.DrawingArea()
        self.da.set_size_request(48, 48)
        self.da.connect("draw", self.on_draw)

        lbl_t = Gtk.Label(label=f"{self.icon_str} {self.title_str}")
        lbl_t.get_style_context().add_class("metric-title")

        self.pack_start(self.da, False, False, 0)
        self.pack_start(lbl_t, False, False, 0)
        self.value_text = "0"
        self.pct = 50

    def set_data(self, val_text, pct=50):
        self.value_text = val_text
        self.pct = pct
        self.da.queue_draw()

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        xc, yc = w / 2, h / 2
        r = min(w, h) / 2 - 5

        # Track
        cr.set_line_width(4.0)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.12)
        cr.arc(xc, yc, r, 0, 2 * math.pi)
        cr.stroke()

        # Arc
        start = -math.pi / 2
        end = start + (self.pct / 100.0) * (2 * math.pi)
        cr.set_source_rgba(*PRIMARY_RGB)
        cr.arc(xc, yc, r, start, end)
        cr.stroke()

        # Value text inside
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(11)
        ext = cr.text_extents(self.value_text)
        cr.move_to(xc - ext.width / 2, yc + 4)
        cr.show_text(self.value_text)


class AestheticCalendarDashboard(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Calendar & Weather Dashboard")

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "calendar-popup")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        if hasattr(GtkLayerShell, "set_keyboard_mode"):
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        else:
            GtkLayerShell.set_keyboard_interactivity(self, True)

        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 38)

        self.get_style_context().add_class("cal-window")
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_TEMPLATE.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        now = datetime.datetime.now()
        self.curr_year = now.year
        self.curr_month = now.month
        self.today_year = now.year
        self.today_month = now.month
        self.today_day = now.day

        # Main Panel (Width: 920px, Height: 350px)
        self.panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=26)
        self.panel.get_style_context().add_class("cal-panel")
        self.panel.set_size_request(920, 350)

        # ---------------- 1. LEFT COLUMN: Monthly Calendar ----------------
        left_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        left_box.set_size_request(290, -1)

        # Left Header (<  MAY 2026  >  +)
        cal_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

        btn_prev = Gtk.Button(label="‹")
        btn_prev.get_style_context().add_class("cal-nav-btn")
        btn_prev.connect("clicked", self.on_prev_month)

