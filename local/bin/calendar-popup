        self.lbl_month_hdr.get_style_context().add_class("cal-month-title")

        btn_next = Gtk.Button(label="›")
        btn_next.get_style_context().add_class("cal-nav-btn")
        btn_next.connect("clicked", self.on_next_month)

        btn_today = Gtk.Button(label="+")
        btn_today.get_style_context().add_class("cal-nav-btn")
        btn_today.connect("clicked", self.on_goto_today)

        cal_hdr.pack_start(btn_prev, False, False, 0)
        cal_hdr.pack_start(self.lbl_month_hdr, True, True, 0)
        cal_hdr.pack_start(btn_next, False, False, 0)
        cal_hdr.pack_start(btn_today, False, False, 0)

        # Calendar Days Grid (7 x 6)
        self.grid = Gtk.Grid()
        self.grid.set_column_homogeneous(True)
        self.grid.set_row_homogeneous(True)
        self.grid.set_column_spacing(3)
        self.grid.set_row_spacing(3)

        # Holiday Notice Label
        self.lbl_holiday_notice = Gtk.Label(label="")
        self.lbl_holiday_notice.get_style_context().add_class("holiday-notice-lbl")
        self.lbl_holiday_notice.set_line_wrap(True)

        left_box.pack_start(cal_hdr, False, False, 0)
        left_box.pack_start(self.grid, True, True, 0)
        left_box.pack_start(self.lbl_holiday_notice, False, False, 0)

        # ---------------- 2. CENTER COLUMN: Giant Orbit Clock ----------------
        self.orbit_clock = OrbitClockArea()
        self.orbit_clock.set_size_request(360, -1)

