#!/usr/bin/env python3
import os
import sys
import time
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell
import cairo

BRIGHTNESS_FILE = "/tmp/brightness_level"
PID_FILE = "/tmp/software_brightness.pid"

class SoftwareBrightnessOverlay(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "software-brightness")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)

        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)

        # 100% Click-through (pass through all mouse & keyboard events)
        self.input_shape_combine_region(cairo.Region())

        self.da = Gtk.DrawingArea()
        self.da.connect("draw", self.on_draw)
        self.add(self.da)

        self.opacity_val = 0.0

        self.show_all()
        GLib.timeout_add(80, self.check_brightness_file)

    def check_brightness_file(self):
        try:
            if os.path.exists(BRIGHTNESS_FILE):
                with open(BRIGHTNESS_FILE, "r") as f:
                    val = float(f.read().strip())
                    # val is 1..100
                    # At 100% -> 0.0 opacity, at 1% -> 0.85 opacity
                    target_op = max(0.0, min(0.85, (100.0 - val) / 100.0 * 0.85))
                    if abs(self.opacity_val - target_op) > 0.005:
                        self.opacity_val = target_op
                        self.da.queue_draw()
        except Exception:
            pass
        return True

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()

        cr.set_source_rgba(0.0, 0.0, 0.0, self.opacity_val)
        cr.rectangle(0, 0, w, h)
        cr.fill()

def main():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE) as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, 9)
    except Exception:
        pass

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    app = SoftwareBrightnessOverlay()
    Gtk.main()

if __name__ == "__main__":
    main()
