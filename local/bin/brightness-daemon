#!/usr/bin/env python3
import os
import sys
import glob
import subprocess
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell
import cairo

BRIGHTNESS_FILE = "/tmp/.brightness_level"

def get_saved_brightness():
    try:
        if os.path.exists(BRIGHTNESS_FILE):
            with open(BRIGHTNESS_FILE, "r") as f:
                val = int(float(f.read().strip()))
                return max(10, min(100, val))
    except Exception:
        pass
    return 100

def try_hardware_brightness(percent):
    try:
        dirs = glob.glob('/sys/class/backlight/*')
        for dev in dirs:
            dev_name = os.path.basename(dev)
            with open(os.path.join(dev, 'max_brightness'), 'r') as f:
                max_b = int(f.read().strip())
            target = max(1, int((percent / 100.0) * max_b))
            subprocess.Popen(['busctl', 'call', 'org.freedesktop.login1', '/org/freedesktop/login1/session/auto', 'org.freedesktop.login1.Session', 'SetBrightness', 'ssu', 'backlight', dev_name, str(target)])
    except Exception:
        pass

class SoftwareDimmer(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "software-brightness")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)

        # 100% Click-through (pass through all mouse & keyboard inputs)
        self.input_shape_combine_region(cairo.Region())

        self.brightness = get_saved_brightness()

        self.da = Gtk.DrawingArea()
        self.da.connect("draw", self.on_draw)
        self.add(self.da)

        self.show_all()

        GLib.timeout_add(50, self.check_file_update)

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # At 100% -> alpha 0.0 (completely clear, no dimming)
        # At 10%  -> alpha 0.76 (dimmed)
        alpha = max(0.0, min(0.85, (100.0 - self.brightness) / 100.0 * 0.85))
        cr.set_source_rgba(0.0, 0.0, 0.0, alpha)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        return False

    def check_file_update(self):
        val = get_saved_brightness()
        if val != self.brightness:
            self.brightness = val
            self.da.queue_draw()
            try_hardware_brightness(val)
        return True

def main():
    lock_file = "/tmp/.brightness_daemon.lock"
    try:
        import fcntl
        fp = open(lock_file, "w")
        fcntl.lockf(fp, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except Exception:
        # If another instance is running, kill it and take over
        try:
            res = subprocess.run(["pgrep", "-f", "brightness-daemon"], capture_output=True, text=True)
            for pid_str in res.stdout.strip().split():
                if int(pid_str) != os.getpid():
                    os.kill(int(pid_str), 9)
        except Exception:
            pass

    app = SoftwareDimmer()
    Gtk.main()

if __name__ == "__main__":
    main()
