class MPVController:
    def __init__(self):
        self.proc = None

    def stop(self):
        if self.proc:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=0.5)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
            self.proc = None
        if os.path.exists(MPV_SOCKET):
            try:
                os.remove(MPV_SOCKET)
            except Exception:
                pass

    def play(self, url):
        self.stop()
        try:
            self.proc = subprocess.Popen([
                "mpv", "--no-video",
                f"--input-ipc-server={MPV_SOCKET}",
                url
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            print("Failed to start mpv:", e)

    def send_cmd(self, command):
        if not os.path.exists(MPV_SOCKET):
            return None
        try:
            client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            client.settimeout(0.5)
            client.connect(MPV_SOCKET)
            payload = json.dumps({"command": command}) + "\n"
            client.sendall(payload.encode('utf-8'))
            response = client.recv(4096).decode('utf-8')
            client.close()
            if response:
                for line in response.splitlines():
                    try:
                        res_data = json.loads(line)
                        if "data" in res_data:
                            return res_data["data"]
                    except Exception:
                        pass
        except Exception:
            return None

    def toggle_pause(self):
        paused = self.send_cmd(["get_property", "pause"])
        if paused is not None:
            new_state = not paused
            self.send_cmd(["set_property", "pause", new_state])
            return new_state
        return False

    def get_time_pos(self):
        pos = self.send_cmd(["get_property", "time-pos"])
        return float(pos) if pos is not None else 0.0

    def get_duration(self):
        dur = self.send_cmd(["get_property", "duration"])
        return float(dur) if dur is not None else 0.0

    def seek(self, seconds):
        self.send_cmd(["seek", seconds, "absolute"])


class YTMusicPlayerWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("YouTube Music Desktop")
        self.set_default_size(580, 720)

        self.get_style_context().add_class("yt-window")
        self.connect("destroy", self.on_window_close)
        self.connect("key-press-event", self.on_key_press)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.mpv = MPVController()
        self.queue = []
        self.queue_index = -1
        self.current_item = None
        self.is_user_seeking = False
        self.is_track_ending = False

        # Main Panel
        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.panel.get_style_context().add_class("yt-panel")

        # Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_title = Gtk.Label(label="󰓇  YouTube Music")
        lbl_title.get_style_context().add_class("header-title")
        lbl_title.set_halign(Gtk.Align.START)

        self.lbl_status = Gtk.Label(label="")
        self.lbl_status.get_style_context().add_class("song-artist")

        btn_fullscreen = Gtk.Button(label="⛶")
        btn_fullscreen.get_style_context().add_class("btn-header")
        btn_fullscreen.connect("clicked", lambda w: self.fullscreen() if not self.is_maximized() else self.unfullscreen())

        btn_close = Gtk.Button(label="✕")
        btn_close.get_style_context().add_class("btn-header")
        btn_close.connect("clicked", lambda w: Gtk.main_quit())

        header.pack_start(lbl_title, False, False, 0)
        header.pack_start(self.lbl_status, True, True, 0)
        header.pack_start(btn_fullscreen, False, False, 0)
        header.pack_start(btn_close, False, False, 0)

        # Search Bar
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.entry_search = Gtk.Entry()
        self.entry_search.set_placeholder_text("🔍 Search song or artist...")
        self.entry_search.get_style_context().add_class("search-entry")
        self.entry_search.connect("activate", self.on_search)

        btn_search = Gtk.Button(label="Search")
        btn_search.get_style_context().add_class("btn-search")
        btn_search.connect("clicked", self.on_search)

        search_box.pack_start(self.entry_search, True, True, 0)
        search_box.pack_start(btn_search, False, False, 0)

        # Now Playing Player Card
        player_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        player_card.set_halign(Gtk.Align.CENTER)

        # Cover Art Image
        self.img_cover = Gtk.Image()
        self.img_cover.get_style_context().add_class("cover-art")
        self.img_cover.set_size_request(200, 200)
        self.set_default_cover()

        self.lbl_song = Gtk.Label(label="No Track Playing")
        self.lbl_song.get_style_context().add_class("song-title")
        self.lbl_song.set_line_wrap(True)
        self.lbl_song.set_max_width_chars(35)
        self.lbl_song.set_justify(Gtk.Justification.CENTER)

        self.lbl_artist = Gtk.Label(label="Search for a song below")
        self.lbl_artist.get_style_context().add_class("song-artist")

        # Progress bar slider
        progress_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.lbl_time = Gtk.Label(label="00:00")
        self.lbl_time.get_style_context().add_class("song-artist")

        self.scale_progress = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_progress.set_draw_value(False)
        self.scale_progress.set_hexpand(True)
        self.slider_handler_id = self.scale_progress.connect("change-value", self.on_slider_change)

        self.lbl_dur = Gtk.Label(label="00:00")
        self.lbl_dur.get_style_context().add_class("song-artist")

        progress_box.pack_start(self.lbl_time, False, False, 0)
        progress_box.pack_start(self.scale_progress, True, True, 0)
        progress_box.pack_start(self.lbl_dur, False, False, 0)

        # Controls Row: Prev, Play, Next, Download
        ctrl_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        ctrl_box.set_halign(Gtk.Align.CENTER)

        btn_prev = Gtk.Button(label="⏮")
        btn_prev.get_style_context().add_class("btn-ctrl")
        btn_prev.connect("clicked", lambda w: self.play_prev_track())

        self.btn_play = Gtk.Button(label="󰐊")
        self.btn_play.get_style_context().add_class("btn-play")
        self.btn_play.connect("clicked", self.on_toggle_play)

        btn_next = Gtk.Button(label="⏭")
        btn_next.get_style_context().add_class("btn-ctrl")
        btn_next.connect("clicked", lambda w: self.play_next_track())

        btn_download = Gtk.Button(label="📥 Download MP3")
        btn_download.get_style_context().add_class("btn-download")
        btn_download.connect("clicked", self.on_download_current)

        ctrl_box.pack_start(btn_prev, False, False, 0)
        ctrl_box.pack_start(self.btn_play, False, False, 0)
        ctrl_box.pack_start(btn_next, False, False, 0)
        ctrl_box.pack_start(btn_download, False, False, 0)

        player_card.pack_start(self.img_cover, False, False, 0)
        player_card.pack_start(self.lbl_song, False, False, 0)
        player_card.pack_start(self.lbl_artist, False, False, 0)
        player_card.pack_start(progress_box, False, False, 0)
        player_card.pack_start(ctrl_box, False, False, 0)

        # Tab Switcher Header (Search Results vs Queue Playlist)
        tabs_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)

        self.btn_tab_search = Gtk.Button(label="🔍 Search Results")
        self.btn_tab_search.get_style_context().add_class("tab-btn")
        self.btn_tab_search.get_style_context().add_class("active")
        self.btn_tab_search.connect("clicked", lambda w: self.switch_view(0))

        self.btn_tab_queue = Gtk.Button(label="📜 Up Next (Queue: 0)")
        self.btn_tab_queue.get_style_context().add_class("tab-btn")
        self.btn_tab_queue.connect("clicked", lambda w: self.switch_view(1))

        tabs_box.pack_start(self.btn_tab_search, True, True, 0)
        tabs_box.pack_start(self.btn_tab_queue, True, True, 0)

        # Stack Container for Tab Switching
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(200)

        # Page 0: Search Results List
        scrolled_search = Gtk.ScrolledWindow()
        scrolled_search.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled_search.set_vexpand(True)
        self.results_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scrolled_search.add(self.results_box)

        # Page 1: Queue Playlist List
        scrolled_queue = Gtk.ScrolledWindow()
        scrolled_queue.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled_queue.set_vexpand(True)
        self.queue_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scrolled_queue.add(self.queue_box)

        self.stack.add_named(scrolled_search, "search")
        self.stack.add_named(scrolled_queue, "queue")

        self.panel.pack_start(header, False, False, 0)
        self.panel.pack_start(search_box, False, False, 0)
        self.panel.pack_start(player_card, False, False, 0)
        self.panel.pack_start(tabs_box, False, False, 0)
        self.panel.pack_start(self.stack, True, True, 0)

        self.add(self.panel)
        self.render_queue_list()
        self.show_all()

        GLib.timeout_add(1000, self.update_playback_status)

    def switch_view(self, index):
        if index == 0:
            self.btn_tab_search.get_style_context().add_class("active")
            self.btn_tab_queue.get_style_context().remove_class("active")
            self.stack.set_visible_child_name("search")
        else:
            self.btn_tab_queue.get_style_context().add_class("active")
            self.btn_tab_search.get_style_context().remove_class("active")
            self.stack.set_visible_child_name("queue")

    def on_window_close(self, widget):
        self.mpv.stop()
        Gtk.main_quit()

    def set_default_cover(self):
        pixbuf = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, 200, 200)
        pixbuf.fill(0x161624ff)
        self.img_cover.set_from_pixbuf(pixbuf)

    def load_cover_art_async(self, thumb_url):
        def _fetch():
            try:
                req = urllib.request.Request(thumb_url, headers={'User-Agent': 'Mozilla/5.0'})
                data = urllib.request.urlopen(req, timeout=5).read()
                loader = GdkPixbuf.PixbufLoader()
                loader.write(data)
                loader.close()
                pixbuf = loader.get_pixbuf()
                scaled = pixbuf.scale_simple(200, 200, GdkPixbuf.InterpType.BILINEAR)
                GLib.idle_add(self.img_cover.set_from_pixbuf, scaled)
            except Exception as e:
                print("Failed to load cover art:", e)

        threading.Thread(target=_fetch, daemon=True).start()

    def on_search(self, widget):
        query = self.entry_search.get_text().strip()
        if not query:
            return

        self.switch_view(0)
        for child in self.results_box.get_children():
            self.results_box.remove(child)

        lbl_loading = Gtk.Label(label="Searching YouTube Music...")
        lbl_loading.get_style_context().add_class("song-artist")
        self.results_box.pack_start(lbl_loading, False, False, 0)
        self.results_box.show_all()

        threading.Thread(target=self._perform_search_async, args=(query,), daemon=True).start()

    def _perform_search_async(self, query):
        try:
            url = f"https://www.youtube.com/results?search_query={urllib.parse.quote(query + ' audio')}"
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'})
            html = urllib.request.urlopen(req, timeout=5).read().decode('utf-8')
            vids = list(dict.fromkeys(re.findall(r'/watch\?v=([a-zA-Z0-9_-]{11})', html)))[:6]

            results = []
            for vid in vids:
                try:
                    oembed_url = f"https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v={vid}&format=json"
                    oreq = urllib.request.Request(oembed_url, headers={'User-Agent': 'Mozilla/5.0'})
                    data = json.loads(urllib.request.urlopen(oreq, timeout=3).read().decode('utf-8'))
                    results.append({
                        'id': vid,
                        'title': data.get('title', 'Unknown Title'),
                        'artist': data.get('author_name', 'Unknown Artist'),
                        'thumb': data.get('thumbnail_url', f'https://img.youtube.com/vi/{vid}/hqdefault.jpg')
                    })
                except Exception:
                    pass

            GLib.idle_add(self._render_search_results, results)
        except Exception as e:
            GLib.idle_add(self._render_search_error, str(e))

    def _render_search_error(self, err_msg):
        for child in self.results_box.get_children():
            self.results_box.remove(child)
        lbl = Gtk.Label(label=f"Search failed: {err_msg}")
        lbl.get_style_context().add_class("song-artist")
        self.results_box.pack_start(lbl, False, False, 0)
        self.results_box.show_all()

    def _render_search_results(self, results):
        for child in self.results_box.get_children():
            self.results_box.remove(child)

        if not results:
            lbl = Gtk.Label(label="No songs found")
            lbl.get_style_context().add_class("song-artist")
            self.results_box.pack_start(lbl, False, False, 0)
        else:
            for item in results:
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                card.get_style_context().add_class("result-card")

                info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                lbl_t = Gtk.Label(label=item['title'])
                lbl_t.get_style_context().add_class("song-title")
                lbl_t.set_halign(Gtk.Align.START)
                lbl_t.set_line_wrap(True)

                lbl_a = Gtk.Label(label=item['artist'])
                lbl_a.get_style_context().add_class("song-artist")
                lbl_a.set_halign(Gtk.Align.START)

                info_box.pack_start(lbl_t, False, False, 0)
                info_box.pack_start(lbl_a, False, False, 0)

                btn_p = Gtk.Button(label="▶ Play")
                btn_p.get_style_context().add_class("btn-download")
                btn_p.connect("clicked", self._create_play_callback(item))

                btn_q = Gtk.Button(label="+ Queue")
                btn_q.get_style_context().add_class("btn-queue-add")
                btn_q.connect("clicked", self._create_add_queue_callback(item))

                card.pack_start(info_box, True, True, 0)
                card.pack_start(btn_p, False, False, 0)
                card.pack_start(btn_q, False, False, 0)
                self.results_box.pack_start(card, False, False, 0)

        self.results_box.show_all()

    def _create_play_callback(self, item):
        return lambda widget: self.play_now(item)

    def _create_add_queue_callback(self, item):
        return lambda widget: self.add_to_queue(item)

    def add_to_queue(self, item):
        self.queue.append(item)
        self.btn_tab_queue.set_label(f"📜 Up Next (Queue: {len(self.queue)})")
        self.render_queue_list()
        subprocess.run(["notify-send", "➕ Queue Updated", f"Added '{item['title']}' to Up Next Queue!"])

    def play_now(self, item):
        # Insert or play immediately
        if item in self.queue:
            self.queue_index = self.queue.index(item)
        else:
            self.queue.append(item)
            self.queue_index = len(self.queue) - 1

        self.play_track_at_index(self.queue_index)

    def play_track_at_index(self, index):
        if 0 <= index < len(self.queue):
            self.queue_index = index
            item = self.queue[index]
            self.current_item = item

            self.lbl_song.set_text(item['title'])
            self.lbl_artist.set_text(item['artist'])
            self.lbl_status.set_text("⏳ Extracting audio stream...")
            self.load_cover_art_async(item['thumb'])

            self.btn_tab_queue.set_label(f"📜 Up Next (Queue: {len(self.queue)})")
            self.render_queue_list()

            page_url = f"https://www.youtube.com/watch?v={item['id']}"
            threading.Thread(target=self._extract_and_play_async, args=(page_url,), daemon=True).start()

    def play_next_track(self):
        if self.queue_index + 1 < len(self.queue):
            self.play_track_at_index(self.queue_index + 1)
        else:
            self.lbl_status.set_text("🔚 End of Queue")

    def play_prev_track(self):
        if self.queue_index - 1 >= 0:
            self.play_track_at_index(self.queue_index - 1)

    def render_queue_list(self):
        for child in self.queue_box.get_children():
            self.queue_box.remove(child)

        if not self.queue:
            lbl = Gtk.Label(label="Queue is empty. Search and add songs to Up Next!")
            lbl.get_style_context().add_class("song-artist")
            lbl.set_margin_top(40)
            self.queue_box.pack_start(lbl, False, False, 0)
        else:
            for idx, item in enumerate(self.queue):
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                if idx == self.queue_index:
                    card.get_style_context().add_class("queue-card-active")
                else:
                    card.get_style_context().add_class("result-card")

                lbl_num = Gtk.Label(label=f"#{idx+1}")
                lbl_num.get_style_context().add_class("song-artist")

                info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                title_prefix = "▶ " if idx == self.queue_index else ""
                lbl_t = Gtk.Label(label=f"{title_prefix}{item['title']}")
                lbl_t.get_style_context().add_class("song-title")
                lbl_t.set_halign(Gtk.Align.START)
                lbl_t.set_line_wrap(True)

                lbl_a = Gtk.Label(label=item['artist'])
                lbl_a.get_style_context().add_class("song-artist")
                lbl_a.set_halign(Gtk.Align.START)

                info_box.pack_start(lbl_t, False, False, 0)
                info_box.pack_start(lbl_a, False, False, 0)

                btn_p = Gtk.Button(label="▶ Play")
                btn_p.get_style_context().add_class("btn-download")
                btn_p.connect("clicked", lambda w, i=idx: self.play_track_at_index(i))

                btn_del = Gtk.Button(label="✕")
                btn_del.get_style_context().add_class("btn-header")
                btn_del.connect("clicked", lambda w, i=idx: self.remove_from_queue(i))

                card.pack_start(lbl_num, False, False, 0)
                card.pack_start(info_box, True, True, 0)
                card.pack_start(btn_p, False, False, 0)
                card.pack_start(btn_del, False, False, 0)

                self.queue_box.pack_start(card, False, False, 0)

        self.queue_box.show_all()

    def remove_from_queue(self, index):
        if 0 <= index < len(self.queue):
            del self.queue[index]
            if self.queue_index >= len(self.queue):
                self.queue_index = max(0, len(self.queue) - 1)
            self.btn_tab_queue.set_label(f"📜 Up Next (Queue: {len(self.queue)})")
            self.render_queue_list()

    def _extract_and_play_async(self, page_url):
        try:
            res = subprocess.run(
                ["yt-dlp", "-g", "-f", "bestaudio/best", page_url],
                capture_output=True, text=True, timeout=12
            )
            if res.returncode == 0 and res.stdout.strip():
                stream_url = res.stdout.strip().splitlines()[0]
                self.mpv.play(stream_url)
                GLib.idle_add(self._on_play_started)
            else:
                self.mpv.play(page_url)
                GLib.idle_add(self._on_play_started)
        except Exception as e:
            GLib.idle_add(self.lbl_status.set_text, "❌ Stream error")

    def _on_play_started(self):
        self.lbl_status.set_text("▶ Playing")
        self.btn_play.set_label("󰏤")

    def on_toggle_play(self, widget):
        paused = self.mpv.toggle_pause()
        self.btn_play.set_label("󰐊" if paused else "󰏤")
        self.lbl_status.set_text("⏸ Paused" if paused else "▶ Playing")

    def on_download_current(self, widget):
        if not self.current_item:
            return

        def _download():
            try:
                subprocess.run(["notify-send", "📥 YT Music Downloader", f"Downloading '{self.current_item['title']}'..."])
                music_dir = os.path.expanduser("~/Music")
                os.makedirs(music_dir, exist_ok=True)

                out_path = os.path.join(music_dir, "%(title)s.%(ext)s")
                page_url = f"https://www.youtube.com/watch?v={self.current_item['id']}"
                res = subprocess.run([
                    "yt-dlp", "-x", "--audio-format", "mp3",
                    "-o", out_path, page_url
                ], capture_output=True)

                if res.returncode == 0:
                    subprocess.run(["notify-send", "✅ Download Complete", f"Saved '{self.current_item['title']}' to ~/Music!"])
                else:
                    subprocess.run(["notify-send", "❌ Download Failed", "yt-dlp error during download."])
            except Exception as e:
                subprocess.run(["notify-send", "❌ Download Failed", str(e)])

        threading.Thread(target=_download, daemon=True).start()

    def on_slider_change(self, scale, scroll_type, value):
        self.is_user_seeking = True
        self.mpv.seek(value)
        GLib.timeout_add(600, self._reset_seeking_flag)

    def _reset_seeking_flag(self):
        self.is_user_seeking = False
        return False

    def update_playback_status(self):
        if self.is_user_seeking:
            return True

        pos = self.mpv.get_time_pos()
        dur = self.mpv.get_duration()

        if dur > 0:
            if hasattr(self, 'slider_handler_id'):
                self.scale_progress.handler_block(self.slider_handler_id)

            self.scale_progress.set_range(0, dur)
            self.scale_progress.set_value(pos)

            if hasattr(self, 'slider_handler_id'):
                self.scale_progress.handler_unblock(self.slider_handler_id)

            pos_min, pos_sec = int(pos // 60), int(pos % 60)
            dur_min, dur_sec = int(dur // 60), int(dur % 60)

            self.lbl_time.set_text(f"{pos_min:02d}:{pos_sec:02d}")
            self.lbl_dur.set_text(f"{dur_min:02d}:{dur_sec:02d}")

            # Auto-advance queue when track finishes
            if dur - pos <= 1.5 and pos > 5:
                if not self.is_track_ending:
                    self.is_track_ending = True
                    GLib.timeout_add(1500, self._auto_advance_track)
        else:
            self.is_track_ending = False

        return True

    def _auto_advance_track(self):
        self.is_track_ending = False
        if self.queue_index + 1 < len(self.queue):
            self.play_next_track()
        return False

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.mpv.stop()
            Gtk.main_quit()
            return True
        return False


def main():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 15)
            os.remove(PID_FILE)
            return
        except Exception:
            pass

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    try:
        app = YTMusicPlayerWindow()
        Gtk.main()
    finally:
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass


if __name__ == "__main__":
    main()
