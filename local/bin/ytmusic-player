class AnimatedWaveformVisualizer(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.set_size_request(-1, 36)
        self.is_playing = False
        self.bars = [random.uniform(0.2, 0.8) for _ in range(40)]
        self.connect("draw", self.on_draw)
        GLib.timeout_add(60, self.on_animate)

    def on_animate(self):
        if self.is_playing:
            for i in range(len(self.bars)):
                self.bars[i] = max(0.15, min(1.0, self.bars[i] + random.uniform(-0.20, 0.20)))
            self.queue_draw()
        return True

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        n_bars = len(self.bars)
        spacing = 3.5
        bar_w = max(2.5, (w - (n_bars * spacing)) / n_bars)

        for i, val in enumerate(self.bars):
            bar_h = val * (h - 4.0)
            x = i * (bar_w + spacing)
            y = (h - bar_h) / 2.0

            pat = cairo.LinearGradient(x, y, x, y + bar_h)
            pat.add_color_stop_rgba(0.0, 1.0, 0.0, 0.33, 0.90)  # Hot Pink
            pat.add_color_stop_rgba(1.0, 0.48, 0.63, 0.97, 0.85) # Cyan/Blue
            cr.set_source(pat)

            cr.rectangle(x, y, bar_w, bar_h)
            cr.fill()


class MPVController:
    def __init__(self):
        self.proc = None

    def stop(self):
        if self.proc:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=0.5)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
            self.proc = None
        if os.path.exists(MPV_SOCKET):
            try:
                os.remove(MPV_SOCKET)
            except Exception:
                pass

    def play(self, url):
        self.stop()
        try:
            self.proc = subprocess.Popen([
                "mpv", "--no-video",
                f"--input-ipc-server={MPV_SOCKET}",
                url
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            print("Failed to start mpv:", e)

    def send_cmd(self, command):
        if not os.path.exists(MPV_SOCKET):
            return None
        try:
            client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            client.settimeout(0.5)
            client.connect(MPV_SOCKET)
            payload = json.dumps({"command": command}) + "\n"
            client.sendall(payload.encode('utf-8'))
            response = client.recv(4096).decode('utf-8')
            client.close()
            if response:
                for line in response.splitlines():
                    try:
                        res_data = json.loads(line)
                        if "data" in res_data:
                            return res_data["data"]
                    except Exception:
                        pass
        except Exception:
            return None

    def toggle_pause(self):
        paused = self.send_cmd(["get_property", "pause"])
        if paused is not None:
            new_state = not paused
            self.send_cmd(["set_property", "pause", new_state])
            return new_state
        return False

    def get_time_pos(self):
        pos = self.send_cmd(["get_property", "time-pos"])
        return float(pos) if pos is not None else 0.0

    def get_duration(self):
        dur = self.send_cmd(["get_property", "duration"])
        return float(dur) if dur is not None else 0.0

    def seek(self, seconds):
        self.send_cmd(["seek", seconds, "absolute"])


