#!/usr/bin/env python3
import subprocess
import json
import sys

def get_nvidia_info():
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu,name", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=2
        )
        if res.returncode == 0 and res.stdout.strip():
            parts = [p.strip() for p in res.stdout.strip().split(",")]
            if len(parts) >= 5:
                return {
                    "available": True,
                    "name": parts[4],
                    "util": int(parts[0]),
                    "mem_used_mb": int(parts[1]),
                    "mem_total_mb": int(parts[2]),
                    "temp": int(parts[3])
                }
    except Exception:
        pass
    return None

def get_gpu_processes():
    procs = []
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=2
        )
        if res.returncode == 0 and res.stdout.strip():
            for line in res.stdout.strip().splitlines():
                parts = [p.strip() for p in line.split(",")]
                if len(parts) >= 3:
                    name = parts[1].split("/")[-1]
                    mem = parts[2]
                    procs.append((name, mem))
    except Exception:
        pass
    return procs

def main():
    info = get_nvidia_info()
    
    if not info or not info["available"]:
        out = {
            "text": "󰢮  N/A",
            "tooltip": "GPU not detected or powered off",
            "class": "gpu"
        }
        print(json.dumps(out))
        return

    util = info["util"]
    mem_used = info["mem_used_mb"]
    mem_total = info["mem_total_mb"]
    temp = info["temp"]
    name = info["name"]
    mem_pct = round((mem_used / mem_total) * 100) if mem_total > 0 else 0
    procs = get_gpu_processes()

    if len(sys.argv) > 1 and sys.argv[1] == "notify":
        msg = f"GPU: {name}\nUsage: {util}%\nTemp: {temp}°C\nVRAM: {mem_used}MB / {mem_total}MB ({mem_pct}%)"
        if procs:
            msg += "\n\nProcesses:\n" + "\n".join([f"• {p[0]}: {p[1]}MB" for p in procs])
        subprocess.run(["notify-send", "-a", "Waybar GPU", "GPU Status", msg])
        return

    proc_text = ""
    if procs:
        proc_lines = [f"{i+1}. {p[0]:<16} {p[1]:>5} MB" for i, p in enumerate(procs)]
        proc_text = "\n\n<b>Active GPU Processes:</b>\n<tt>" + "\n".join(proc_lines) + "</tt>"

    tooltip = (
        f"<b>󰢮  GPU: {name}</b>\n"
        f"Usage: {util}%\n"
        f"Temperature: {temp}°C\n"
        f"VRAM: {mem_used} MiB / {mem_total} MiB ({mem_pct}%)\n"
        f"{proc_text}\n\n"
        f"<i>󰍹 Click: Open System Monitor (btop)</i>"
    )

    out = {
        "text": f"󰢮  {util}%",
        "tooltip": tooltip,
        "class": "gpu"
    }
    print(json.dumps(out))

if __name__ == "__main__":
    main()
