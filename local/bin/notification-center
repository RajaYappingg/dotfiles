def hex_to_rgb(hex_str):
    try:
        hex_str = hex_str.lstrip("#")
        if len(hex_str) == 6:
            return tuple(int(hex_str[i:i+2], 16) / 255.0 for i in (0, 2, 4))
    except Exception:
        pass
    return (0.8, 0.45, 0.35)

def load_wallpaper_colors():
    colors = {
        'primary': '#cc7257',
        'secondary': '#4141bf',
        'bg_dark': '#20131a',
        'bg_pill': '#342129',
        'text_main': '#ffffff',
        'border_accent': '#cc7257'
    }
    path = os.path.expanduser("~/.config/waybar/colors.css")
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                for line in f:
                    m = re.search(r"@define-color\s+(\w+)\s+(#[0-9a-fA-F]{6});", line)
                    if m:
                        colors[m.group(1)] = m.group(2)
        except Exception:
            pass
    return colors

# Load dynamic wallpaper color palette
PALETTE = load_wallpaper_colors()
PRIMARY_HEX = PALETTE.get('primary', '#cc7257')
SECONDARY_HEX = PALETTE.get('secondary', '#4141bf')
BG_DARK_HEX = PALETTE.get('bg_dark', '#20131a')
BG_PILL_HEX = PALETTE.get('bg_pill', '#342129')

PRIMARY_RGB = hex_to_rgb(PRIMARY_HEX)
SECONDARY_RGB = hex_to_rgb(SECONDARY_HEX)

# Convert HEX to RGBA string for GTK CSS
def hex_to_rgba_str(hex_str, alpha=1.0):
    r, g, b = hex_to_rgb(hex_str)
    return f"rgba({int(r*255)}, {int(g*255)}, {int(b*255)}, {alpha})"

