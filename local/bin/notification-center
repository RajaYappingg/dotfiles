def ease_out_cubic(t):
    t = max(0.0, min(1.0, t))
    return 1.0 - math.pow(1.0 - t, 3)

def ease_in_cubic(t):
    t = max(0.0, min(1.0, t))
    return t * t * t


class ThickRadialGauge(Gtk.DrawingArea):
    def __init__(self, title, icon, color_rgb):
        super().__init__()
        self.title = title
        self.icon = icon
        self.color_rgb = color_rgb
        self.value_str = "0%"
        self.pct = 0
        self.set_size_request(130, 130)
        self.connect("draw", self.on_draw)

    def set_val(self, pct, value_str=None):
        self.pct = max(0, min(100, pct))
        self.value_str = value_str if value_str is not None else f"{int(self.pct)}%"
        self.queue_draw()

    def on_draw(self, widget, cr):
        w = self.get_allocated_width()
        h = self.get_allocated_height()
        xc, yc = w / 2, (h / 2) - 10
        r = min(w, h) / 2 - 16

        # 1. Dark Recessed Track (Thick: 14px)
        cr.set_line_width(14)
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.45)
        cr.arc(xc, yc, r, 0, 2 * math.pi)
        cr.stroke()

        # 2. Thick Colored Progress Arc
        if self.pct > 0:
            start = -math.pi / 2
            end = start + (self.pct / 100.0) * (2 * math.pi)
            cr.set_line_width(14)
            cr.set_line_cap(cairo.LINE_CAP_BUTT)
            cr.set_source_rgba(*self.color_rgb)
            cr.arc(xc, yc, r, start, end)
            cr.stroke()

        # 3. Center Text: Icon + Big Percentage
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(15)

        txt = f"{self.icon} {self.value_str}"
        ext = cr.text_extents(txt)
        cr.move_to(xc - ext.width / 2, yc + 5)
        cr.show_text(txt)

        # 4. Subtitle below ring
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.55)
        cr.set_font_size(10)
        ext_t = cr.text_extents(self.title)
        cr.move_to(xc - ext_t.width / 2, h - 2)
        cr.show_text(self.title)


class NotificationCenterDashboard(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Dashboard Notification Center")

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "notification-center")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        if hasattr(GtkLayerShell, "set_keyboard_mode"):
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        else:
            GtkLayerShell.set_keyboard_interactivity(self, True)

        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)

        self.get_style_context().add_class("notif-window")
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_TEMPLATE.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Main Dashboard Panel (Width: 720px, Height: 580px)
        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.panel.get_style_context().add_class("notif-panel")
        self.panel.set_size_request(720, 580)

        # 1. Header Bar (Title | Digital Clock | Exit Button)
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_icon = Gtk.Label(label="󰂚")
        lbl_icon.get_style_context().add_class("header-title")
        lbl_title = Gtk.Label(label="Notifications")
        lbl_title.get_style_context().add_class("header-title")
        title_box.pack_start(lbl_icon, False, False, 0)
        title_box.pack_start(lbl_title, False, False, 0)

        # Real-time Clock Pill Container (HH:MM :SS like calendar)
        self.lbl_clock_hm = Gtk.Label(label="12:00")
        self.lbl_clock_hm.get_style_context().add_class("clock-main-text")

        self.lbl_clock_sec = Gtk.Label(label=":00")
        self.lbl_clock_sec.get_style_context().add_class("clock-sec-text")
        self.lbl_clock_sec.set_valign(Gtk.Align.CENTER)

        clock_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        clock_box.get_style_context().add_class("clock-pill-container")
        clock_box.pack_start(self.lbl_clock_hm, False, False, 0)
        clock_box.pack_start(self.lbl_clock_sec, False, False, 0)
        clock_box.set_halign(Gtk.Align.CENTER)

        btn_exit = Gtk.Button(label="󰍃")
        btn_exit.get_style_context().add_class("btn-close")
        btn_exit.connect("clicked", lambda w: self.close_drawer())

        header.pack_start(title_box, True, True, 0)
        header.pack_start(clock_box, True, True, 0)
        header.pack_start(btn_exit, False, False, 0)

        # 2. Main Content Split: Left Notifications Column + Right Dashboard Column
        content_grid = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24)

        # ---------------- LEFT COLUMN: Notifications Drawer ----------------
        left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        left_col.set_size_request(320, -1)

        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_vexpand(True)

        self.cards_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.scrolled.add(self.cards_box)
        left_col.pack_start(self.scrolled, True, True, 0)

        # ---------------- RIGHT COLUMN: Gauges, Sliders & Power ----------------
        right_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        right_col.set_size_request(340, -1)

        # A. 2x2 Thick Circular Donut Gauges Grid
        gauges_grid = Gtk.Grid()
        gauges_grid.set_column_spacing(18)
        gauges_grid.set_row_spacing(16)
        gauges_grid.set_column_homogeneous(True)
        gauges_grid.set_row_homogeneous(True)

        self.g_cpu = ThickRadialGauge("CPU LOAD", "󰍛", hex_to_rgb("#89b4fa"))
        self.g_mem = ThickRadialGauge("MEMORY", "󰘚", hex_to_rgb("#cba6f7"))
        self.g_disk = ThickRadialGauge("STORAGE", "󰋊", hex_to_rgb("#74c7ec"))
        self.g_temp = ThickRadialGauge("SYSTEM TEMP", "󰔏", hex_to_rgb("#fab387"))

        gauges_grid.attach(self.g_cpu, 0, 0, 1, 1)
        gauges_grid.attach(self.g_mem, 1, 0, 1, 1)
        gauges_grid.attach(self.g_disk, 0, 1, 1, 1)
        gauges_grid.attach(self.g_temp, 1, 1, 1, 1)

        # B. Sliders (Brightness & Volume)
        sliders_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        # Brightness Slider
        b_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_b = Gtk.Label(label="󰃠")
        lbl_b.get_style_context().add_class("slider-icon")

        self.scale_b = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_b.set_draw_value(False)
        self.scale_b.set_hexpand(True)
        self.scale_b_sig = self.scale_b.connect("value-changed", self.on_b_change)

        b_row.pack_start(lbl_b, False, False, 0)
        b_row.pack_start(self.scale_b, True, True, 0)

        # Volume Slider
        v_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_v = Gtk.Label(label="󰕾")
        lbl_v.get_style_context().add_class("slider-icon")

        self.scale_vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_vol.set_draw_value(False)
        self.scale_vol.set_hexpand(True)
        self.scale_vol_sig = self.scale_vol.connect("value-changed", self.on_vol_change)

        v_row.pack_start(lbl_v, False, False, 0)
        v_row.pack_start(self.scale_vol, True, True, 0)

        sliders_box.pack_start(b_row, False, False, 0)
        sliders_box.pack_start(v_row, False, False, 0)

        # C. Power Controls Row (Lock: 󰌾, Suspend: 󰒲, Reboot: 󰑐, Shutdown: 󰐥)
        power_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        power_box.set_homogeneous(True)

        btn_lock = Gtk.Button(label="󰌾")
        btn_lock.get_style_context().add_class("power-btn")
        btn_lock.get_style_context().add_class("power-btn-lock")
        btn_lock.connect("clicked", lambda w: self.run_cmd("/home/zaki/.local/bin/lockscreen"))

        btn_sleep = Gtk.Button(label="󰒲")
        btn_sleep.get_style_context().add_class("power-btn")
        btn_sleep.get_style_context().add_class("power-btn-sleep")
        btn_sleep.connect("clicked", lambda w: self.run_cmd("systemctl suspend"))

        btn_reboot = Gtk.Button(label="󰑐")
        btn_reboot.get_style_context().add_class("power-btn")
        btn_reboot.get_style_context().add_class("power-btn-reboot")
        btn_reboot.connect("clicked", lambda w: self.run_cmd("systemctl reboot"))

        btn_off = Gtk.Button(label="󰐥")
        btn_off.get_style_context().add_class("power-btn")
        btn_off.get_style_context().add_class("power-btn-red")
        btn_off.connect("clicked", lambda w: self.run_cmd("systemctl poweroff"))

        power_box.pack_start(btn_lock, True, True, 0)
        power_box.pack_start(btn_sleep, True, True, 0)
        power_box.pack_start(btn_reboot, True, True, 0)
        power_box.pack_start(btn_off, True, True, 0)

        # D. Power Mode Selector Bar (Perform: 󰓅, Balance: 󰾆, Saver: 󰌪)
        mode_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        mode_box.get_style_context().add_class("mode-bar")
        mode_box.set_homogeneous(True)

        self.btn_perform = Gtk.Button(label="󰓅 Perform")
        self.btn_perform.get_style_context().add_class("mode-btn")
        self.btn_perform.connect("clicked", lambda w: self.set_power_mode("performance"))

        self.btn_balance = Gtk.Button(label="󰾆 Balance")
        self.btn_balance.get_style_context().add_class("mode-btn")
        self.btn_balance.connect("clicked", lambda w: self.set_power_mode("balanced"))

        self.btn_saver = Gtk.Button(label="󰌪 Saver")
        self.btn_saver.get_style_context().add_class("mode-btn")
        self.btn_saver.connect("clicked", lambda w: self.set_power_mode("power-saver"))

        mode_box.pack_start(self.btn_perform, True, True, 0)
        mode_box.pack_start(self.btn_balance, True, True, 0)
        mode_box.pack_start(self.btn_saver, True, True, 0)

        right_col.pack_start(gauges_grid, False, False, 0)
        right_col.pack_start(sliders_box, False, False, 0)
        right_col.pack_start(power_box, False, False, 0)
        right_col.pack_start(mode_box, False, False, 0)

        content_grid.pack_start(left_col, True, True, 0)
        content_grid.pack_start(right_col, False, False, 0)

        self.panel.pack_start(header, False, False, 0)
        self.panel.pack_start(content_grid, True, True, 0)

        self.add(self.panel)

        # Animation states
        self.start_time = time.time()
        self.is_closing = False
        self.close_time = 0
        self.target_margin = 16
        self.start_margin = -760
        self.last_cpu_idle = 0
        self.last_cpu_total = 0

        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, self.start_margin)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 16)

        self.update_clock()
        self.update_power_mode_ui()
        self.update_system_stats()
        self.load_notifications()
        self.show_all()

        GLib.timeout_add(16, self.on_animation_frame)
        GLib.timeout_add_seconds(1, self.periodic_update)

    def run_cmd(self, cmd):
        try:
            subprocess.Popen(cmd, shell=True)
        except Exception:
            pass

    def get_cmd_out(self, cmd):
        try:
            r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=2)
            return r.stdout.strip()
        except Exception:
            return ""

    def update_clock(self):
        t = time.localtime()
        self.lbl_clock_hm.set_text(time.strftime("%H:%M", t))
        self.lbl_clock_sec.set_text(time.strftime(":%S", t))

    def update_power_mode_ui(self):
        current_mode = self.get_cmd_out("powerprofilesctl get") or "balanced"

        self.btn_perform.get_style_context().remove_class("active")
        self.btn_balance.get_style_context().remove_class("active")
        self.btn_saver.get_style_context().remove_class("active")

        if current_mode == "performance":
            self.btn_perform.get_style_context().add_class("active")
        elif current_mode == "power-saver":
            self.btn_saver.get_style_context().add_class("active")
        else:
            self.btn_balance.get_style_context().add_class("active")

        self.btn_perform.queue_draw()
        self.btn_balance.queue_draw()
        self.btn_saver.queue_draw()

    def set_power_mode(self, mode):
        self.run_cmd(f"powerprofilesctl set {mode}")
        GLib.timeout_add(100, self.update_power_mode_ui)

    def update_system_stats(self):
        # 1. CPU Usage %
        try:
            with open("/proc/stat") as f:
                fields = [float(x) for x in f.readline().split()[1:]]
                idle, total = fields[3], sum(fields)
                if self.last_cpu_total > 0:
                    d_idle = idle - self.last_cpu_idle
                    d_total = total - self.last_cpu_total
                    cpu_pct = int((1.0 - (d_idle / d_total)) * 100)
                else:
                    cpu_pct = 14
                self.last_cpu_idle = idle
                self.last_cpu_total = total
                self.g_cpu.set_val(cpu_pct)
        except Exception:
            pass

        # 2. Memory %
        try:
            with open("/proc/meminfo") as f:
                mem = {}
                for line in f:
                    parts = line.split()
                    mem[parts[0].rstrip(":")] = int(parts[1])
                mem_pct = int((1.0 - (mem["MemAvailable"] / mem["MemTotal"])) * 100)
                self.g_mem.set_val(mem_pct)
        except Exception:
            pass

        # 3. Storage %
        try:
            st = os.statvfs("/")
            disk_pct = int((1.0 - (st.f_bavail / st.f_blocks)) * 100)
            self.g_disk.set_val(disk_pct)
        except Exception:
            pass

        # 4. Temperature
        temp_val = 43
        for p in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
            try:
                with open(p) as f:
                    v = int(f.read().strip())
                    if 20000 < v < 100000:
                        temp_val = int(v / 1000)
                        break
            except Exception:
                pass
        self.g_temp.set_val(temp_val, f"{temp_val}°")

        # 5. Sliders (Volume & Brightness)
        try:
            if not getattr(self, 'is_user_interacting_vol', False):
                vol_out = self.get_cmd_out("wpctl get-volume @DEFAULT_AUDIO_SINK@")
                vol_val = float(vol_out.split()[1]) * 100
                self.scale_vol.handler_block(self.scale_vol_sig)
                self.scale_vol.set_value(vol_val)
                self.scale_vol.handler_unblock(self.scale_vol_sig)
        except Exception:
            pass

        try:
            if not getattr(self, 'is_user_interacting_b', False):
                b_val = 100
                if os.path.exists("/tmp/.brightness_level"):
                    try:
                        with open("/tmp/.brightness_level") as f:
                            b_val = float(f.read().strip())
                    except Exception:
                        pass
                else:
                    b_max = float(self.get_cmd_out("brightnessctl m") or "255")
                    b_cur = float(self.get_cmd_out("brightnessctl g") or "128")
                    b_val = (b_cur / b_max) * 100
                self.scale_b.handler_block(self.scale_b_sig)
                self.scale_b.set_value(b_val)
                self.scale_b.handler_unblock(self.scale_b_sig)
        except Exception:
            pass

    def _reset_vol_interacting(self):
        self.is_user_interacting_vol = False
        return False

    def _reset_b_interacting(self):
        self.is_user_interacting_b = False
        return False

    def on_vol_change(self, scale):
        self.is_user_interacting_vol = True
        val = int(scale.get_value())
        self.run_cmd(f"wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ {val}%")
        GLib.timeout_add(1500, self._reset_vol_interacting)

    def on_b_change(self, scale):
        self.is_user_interacting_b = True
        val = max(10, int(scale.get_value()))
        now = time.time()
        if not hasattr(self, '_last_b_exec') or (now - self._last_b_exec > 0.08):
            self._last_b_exec = now
            self.run_cmd(f"/home/zaki/.local/bin/change-brightness {val}")

        if hasattr(self, '_b_timer') and self._b_timer:
            GLib.source_remove(self._b_timer)
        self._b_timer = GLib.timeout_add(1500, self._reset_b_interacting)

    def load_notifications(self):
        for child in self.cards_box.get_children():
            self.cards_box.remove(child)

        notifications = []
        try:
            res = subprocess.run(["dunstctl", "history"], capture_output=True, text=True, timeout=2)
            if res.returncode == 0 and res.stdout.strip():
                data = json.loads(res.stdout)
                if "data" in data and len(data["data"]) > 0 and len(data["data"][0]) > 0:
                    notifications = data["data"][0]
        except Exception:
            pass

        if not notifications:
            empty_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            empty_box.set_valign(Gtk.Align.CENTER)
            empty_box.set_halign(Gtk.Align.CENTER)
            empty_box.set_margin_top(120)

            lbl_icon = Gtk.Label(label="󰂜")
            lbl_icon.get_style_context().add_class("empty-icon")
            lbl_txt = Gtk.Label(label="No Notifications")
            lbl_txt.get_style_context().add_class("empty-label")

            empty_box.pack_start(lbl_icon, False, False, 0)
            empty_box.pack_start(lbl_txt, False, False, 0)
            self.cards_box.pack_start(empty_box, True, True, 0)
        else:
            # Group by appname
            grouped = {}
            for item in notifications:
                appname = item.get("appname", {}).get("data", "System").upper()
                if appname not in grouped:
                    grouped[appname] = []
                grouped[appname].append(item)

            for appname, items in grouped.items():
                app_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                app_hdr.set_margin_top(6)
                app_hdr.set_margin_bottom(2)

                lbl_app = Gtk.Label(label=f"˅  {appname}")
                lbl_app.get_style_context().add_class("app-group-header")

                btn_clear_app = Gtk.Button(label="󰅖")
                btn_clear_app.get_style_context().add_class("icon-mini-btn")
                btn_clear_app.connect("clicked", lambda w: self.on_clear_all())

                app_hdr.pack_start(lbl_app, True, True, 0)
                app_hdr.pack_start(btn_clear_app, False, False, 0)
                self.cards_box.pack_start(app_hdr, False, False, 0)

                for item in items:
                    card = self.create_card_widget(item)
                    self.cards_box.pack_start(card, False, False, 0)

        self.cards_box.show_all()

    def create_card_widget(self, item):
        summary = item.get("summary", {}).get("data", "")
        body = item.get("body", {}).get("data", "")
        appname = item.get("appname", {}).get("data", "System")

        # Calculate timestamp ago string
        timestamp = item.get("timestamp", {}).get("data", 0)
        time_str = ""
        if timestamp > 0:
            diff = int(time.time() - (timestamp / 1000000.0 if timestamp > 1e12 else timestamp))
            if diff < 60:
                time_str = "Just now"
            elif diff < 3600:
                time_str = f"{diff // 60}m ago"
            else:
                time_str = f"{diff // 3600}h ago"

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.get_style_context().add_class("notif-card")

        # Top Bar: App Badge + Timestamp + Close Button
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

        lbl_app = Gtk.Label(label=appname.upper(), xalign=0)
        lbl_app.get_style_context().add_class("notif-app-badge")
        top_bar.pack_start(lbl_app, False, False, 0)

        if time_str:
            lbl_time = Gtk.Label(label=time_str, xalign=1)
            lbl_time.get_style_context().add_class("notif-time-str")
            top_bar.pack_start(lbl_time, True, True, 0)
        else:
            spacer = Gtk.Label(label="")
            top_bar.pack_start(spacer, True, True, 0)

        btn_close_card = Gtk.Button(label="󰅖")
        btn_close_card.get_style_context().add_class("icon-mini-btn")
        btn_close_card.connect("clicked", lambda w: self.on_clear_all())
        top_bar.pack_start(btn_close_card, False, False, 0)

        card.pack_start(top_bar, False, False, 0)

        # Summary Line (Bold 14px)
        if summary:
            lbl_sum = Gtk.Label(label=summary, xalign=0)
            lbl_sum.get_style_context().add_class("card-summary")
            lbl_sum.set_line_wrap(True)
            card.pack_start(lbl_sum, False, False, 0)

        # Body Line (Medium 12px)
        if body:
            lbl_body = Gtk.Label(label=body, xalign=0)
            lbl_body.get_style_context().add_class("card-body")
            lbl_body.set_line_wrap(True)
            card.pack_start(lbl_body, False, False, 0)

        # Inline Action Buttons
        actions = item.get("actions", {}).get("data", [])
        if actions:
            actions_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            actions_box.set_margin_top(6)
            for idx, act in enumerate(actions):
                act_key = act.get("key", "default")
                act_label = act.get("label", "Action")

                btn_act = Gtk.Button(label=act_label)
                if idx == 0:
                    btn_act.get_style_context().add_class("notif-action-primary")
                else:
                    btn_act.get_style_context().add_class("notif-action-secondary")

                btn_act.connect("clicked", lambda w, k=act_key: self.on_action_clicked(k))
                actions_box.pack_start(btn_act, True, True, 0)

            card.pack_start(actions_box, False, False, 0)

        return card

    def on_action_clicked(self, key):
        try:
            subprocess.run(["dunstctl", "action", str(key)])
        except Exception:
            pass
        self.load_notifications()

    def on_clear_all(self):
        try:
            subprocess.run(["dunstctl", "close-all"])
            subprocess.run(["dunstctl", "history-clear"])
        except Exception:
            pass
        self.load_notifications()

    def periodic_update(self):
        if not self.is_closing:
            self.update_clock()
            self.update_system_stats()
            self.load_notifications()
            return True
        return False

    def close_drawer(self):
        if not self.is_closing:
            self.is_closing = True
            self.close_time = time.time()

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.close_drawer()
            return True
        return False

    def on_animation_frame(self):
        now = time.time()
        if not self.is_closing:
            elapsed = now - self.start_time
            if elapsed < 0.32:
                progress = ease_out_cubic(elapsed / 0.32)
                current_margin = int(self.start_margin + (self.target_margin - self.start_margin) * progress)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, current_margin)
                return True
            else:
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, self.target_margin)
                return True
        else:
            c_elapsed = now - self.close_time
            if c_elapsed < 0.25:
                progress = ease_in_cubic(c_elapsed / 0.25)
                current_margin = int(self.target_margin + (self.start_margin - self.target_margin) * progress)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, current_margin)
                return True
            else:
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, self.start_margin)
                Gtk.main_quit()
                return False


def main():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 15)
            os.remove(PID_FILE)
            return
        except Exception:
            pass

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    try:
        app = NotificationCenterDashboard()
        Gtk.main()
    finally:
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass


if __name__ == "__main__":
    main()
