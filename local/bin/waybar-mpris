#!/usr/bin/env bash
# Clean Audio Poller for Waybar

status=$(playerctl status 2>/dev/null)

if [ "$status" = "Playing" ] || [ "$status" = "Paused" ]; then
    artist=$(playerctl metadata xesam:artist 2>/dev/null)
    title=$(playerctl metadata xesam:title 2>/dev/null)

    if [ -z "$title" ]; then title="Playing Audio"; fi

    if [ -n "$artist" ]; then
        track_str="${artist} - ${title}"
    else
        track_str="${title}"
    fi

    if [ ${#track_str} -gt 26 ]; then
        track_str="${track_str:0:23}..."
    fi

    track_str_escaped=$(echo "$track_str" | sed 's/"/\\"/g' | sed 's/&/\&amp;/g')

    echo "{\"text\": \"🎵  ${track_str_escaped}\", \"tooltip\": \"Status: ${status}\n${track_str_escaped}\", \"class\": \"${status,,}\"}"
else
    echo "{\"text\": \"\", \"class\": \"stopped\"}"
fi
