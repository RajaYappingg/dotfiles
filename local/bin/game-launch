#!/bin/bash
# Game Mode Launcher for any Game or App
# Usage: game-launch <command> [args]
# Example: game-launch lunar-client

export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

# Turn ON Game Mode
/home/zaki/.local/bin/game-mode

# Run Game with Feral GameMode
if command -v gamemoded &>/dev/null; then
    gamemode-run "$@"
else
    "$@"
fi

# Turn OFF Game Mode automatically when game closes
/home/zaki/.local/bin/game-mode
