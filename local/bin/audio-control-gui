#!/usr/bin/env python3
import os
import sys
import json
import subprocess
import re

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

CSS = b"""
* {
    font-family: "Inter", "JetBrains Mono", sans-serif;
    outline: none;
    box-shadow: none;
}

window.volumemixer-window {
    background-color: #161a23;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
}

.header-title {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
}

.header-btn {
    background: transparent;
    color: #cbd5e1;
    border: none;
    font-size: 18px;
    padding: 4px 8px;
    border-radius: 8px;
}

.header-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.device-name {
    font-size: 13px;
    font-weight: 500;
    color: #e2e8f0;
}

.vol-num {
    font-size: 13px;
    font-weight: 500;
    color: #94a3b8;
}

scale trough {
    background-color: #2a3243;
    border-radius: 4px;
    min-height: 4px;
}

scale highlight {
    background-color: #0084ff;
    border-radius: 4px;
}

scale slider {
    background-color: #0084ff;
    border-radius: 4px;
    min-width: 6px;
    min-height: 18px;
    margin-top: -7px;
    margin-bottom: -7px;
}

.divider-line {
    background-color: rgba(255, 255, 255, 0.1);
    min-height: 1px;
    margin-top: 8px;
    margin-bottom: 12px;
}

.app-name {
    font-size: 13px;
    font-weight: 500;
    color: #f1f5f9;
}
"""

class ExactVolumeMixer(Gtk.Window):
    def __init__(self):
        super().__init__(title="Volume Mixer")
        self.set_name("volumemixer-window")
        self.set_default_size(380, 260)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("floating_vol", "floating_vol")

        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_vbox.set_margin_top(16)
        main_vbox.set_margin_bottom(16)
        main_vbox.set_margin_left(18)
        main_vbox.set_margin_right(18)
        self.add(main_vbox)

        # 1. Header Row
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        lbl_title = Gtk.Label(label="Volume Mixer", xalign=0)
        lbl_title.get_style_context().add_class("header-title")
        header_box.pack_start(lbl_title, True, True, 0)

        # Output Device Switcher Button (Top Right Icon)
        self.btn_device = Gtk.Button(label="🎧")
        self.btn_device.get_style_context().add_class("header-btn")
        self.btn_device.set_tooltip_text("Ganti Perangkat Suara (Output)")
        self.btn_device.connect("clicked", self.on_cycle_output_device)
        header_box.pack_start(self.btn_device, False, False, 0)

        main_vbox.pack_start(header_box, False, False, 0)

        # 2. Master Output Volume Row
        master_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        master_row.set_margin_top(12)

        self.lbl_master_icon = Gtk.Label(label="🔊")
        master_row.pack_start(self.lbl_master_icon, False, False, 0)

        self.lbl_master_name = Gtk.Label(label="Headphones", xalign=0)
        self.lbl_master_name.get_style_context().add_class("device-name")
        self.lbl_master_name.set_size_request(110, -1)
        master_row.pack_start(self.lbl_master_name, False, False, 0)

        self.scale_master = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_master.set_draw_value(False)
        self.scale_master.connect("value-changed", self.on_master_scale_changed)
        master_row.pack_start(self.scale_master, True, True, 0)

        self.lbl_master_val = Gtk.Label(label="100", xalign=1)
        self.lbl_master_val.get_style_context().add_class("vol-num")
        self.lbl_master_val.set_size_request(30, -1)
        master_row.pack_start(self.lbl_master_val, False, False, 0)

        main_vbox.pack_start(master_row, False, False, 0)

        # Divider
        divider = Gtk.Box()
        divider.get_style_context().add_class("divider-line")
        main_vbox.pack_start(divider, False, False, 0)

        # 3. App Streams List Container
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.apps_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scrolled.add(self.apps_vbox)
        main_box.pack_start(scrolled, True, True, 0)

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", Gtk.main_quit)

        self.refresh_mixer()

    def get_pactl_json(self, target):
        try:
            res = subprocess.run(["pactl", "-f", "json", "list", target], capture_output=True, text=True)
            if res.returncode == 0:
                return json.loads(res.stdout)
        except Exception:
            pass
        return []

    def get_default_sink(self):
        try:
            res = subprocess.run(["pactl", "info"], capture_output=True, text=True)
            for line in res.stdout.splitlines():
                if "Default Sink:" in line:
                    return line.split(":", 1)[1].strip()
        except Exception:
            pass
        return ""

    def refresh_mixer(self):
        # 1. Update Master Device & Volume
        def_sink = self.get_default_sink()
        sinks = [s for s in self.get_pactl_json("sinks") if not s.get("name", "").endswith(".monitor")]
        
        curr_sink_desc = "Headphones"
        for s in sinks:
            if s.get("name") == def_sink:
                desc = s.get("description", "Audio Output")
                if "HDMI" in desc or "GA107" in desc or "MSI" in desc:
                    curr_sink_desc = "MSI G255F"
                    self.lbl_master_icon.set_text("🖥️")
                elif "Speaker" in desc or "Internal" in desc:
                    curr_sink_desc = "Speakers"
                    self.lbl_master_icon.set_text("🔊")
                else:
                    curr_sink_desc = "Headphones"
                    self.lbl_master_icon.set_text("🎧")
                break

        self.lbl_master_name.set_text(curr_sink_desc)

        # Get Master Volume
        master_vol = 100
        try:
            res = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True)
            m = re.search(r"Volume:\s+([0-9.]+)", res.stdout)
            if m:
                master_vol = int(float(m.group(1)) * 100)
        except Exception:
            pass

        self.scale_master.handler_block_by_func(self.on_master_scale_changed)
        self.scale_master.set_value(master_vol)
        self.scale_master.handler_unblock_by_func(self.on_master_scale_changed)
        self.lbl_master_val.set_text(str(master_vol))

        # 2. Update App Streams
        for child in self.apps_vbox.get_children():
            self.apps_vbox.remove(child)

        sink_inputs = self.get_pactl_json("sink-inputs")

        if not sink_inputs:
            lbl_empty = Gtk.Label(label="Tidak ada aplikasi memutar suara", xalign=0)
            lbl_empty.get_style_context().add_class("vol-num")
            self.apps_vbox.pack_start(lbl_empty, False, False, 0)
        else:
            for inp in sink_inputs:
                idx = inp.get("index")
                props = inp.get("properties", {})
                app_name = props.get("application.name") or props.get("node.name") or "Aplikasi"
                
                vol_dict = inp.get("volume", {})
                pct_str = "100%"
                if "front-left" in vol_dict:
                    pct_str = vol_dict["front-left"].get("value_percent", "100%")
                vol_val = int(pct_str.rstrip("%")) if pct_str.endswith("%") else 100

                row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

                # App Icon
                icon_widget = self.get_app_icon(app_name)
                row_box.pack_start(icon_widget, False, False, 0)

                # App Name Label
                lbl_app = Gtk.Label(label=app_name, xalign=0)
                lbl_app.get_style_context().add_class("app-name")
                lbl_app.set_size_request(110, -1)
                row_box.pack_start(lbl_app, False, False, 0)

                # App Slider
                sc_app = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
                sc_app.set_draw_value(False)
                sc_app.set_value(vol_val)
                sc_app.connect("value-changed", lambda sc, i=idx: self.on_app_scale_changed(i, sc))
                row_box.pack_start(sc_app, True, True, 0)

                # App Vol Number Label
                lbl_num = Gtk.Label(label=str(vol_val), xalign=1)
                lbl_num.get_style_context().add_class("vol-num")
                lbl_num.set_size_request(30, -1)
                row_box.pack_start(lbl_num, False, False, 0)

                # Attach label reference to scale widget for real-time updates
                sc_app.lbl_ref = lbl_num

                self.apps_vbox.pack_start(row_box, False, False, 0)

        self.apps_vbox.show_all()

    def get_app_icon(self, app_name):
        name_lower = app_name.lower()
        icon_name = "audio-card"
        
        if "discord" in name_lower:
            icon_name = "discord"
        elif "spotify" in name_lower:
            icon_name = "spotify"
        elif "firefox" in name_lower:
            icon_name = "firefox"
        elif "chrome" in name_lower:
            icon_name = "google-chrome"
        elif "brave" in name_lower:
            icon_name = "brave"
        elif "mpv" in name_lower or "vlc" in name_lower:
            icon_name = "multimedia-player"

        theme = Gtk.IconTheme.get_default()
        if theme.has_icon(icon_name):
            pixbuf = theme.load_icon(icon_name, 22, Gtk.IconLookupFlags.FORCE_SIZE)
            return Gtk.Image.new_from_pixbuf(pixbuf)

        # Fallback colored emoji/icon label
        emoji = "🎵"
        if "discord" in name_lower:
            emoji = "💬"
        elif "spotify" in name_lower:
            emoji = "🎧"
        elif "firefox" in name_lower:
            emoji = "🦊"

        lbl = Gtk.Label(label=emoji)
        lbl.set_size_request(22, 22)
        return lbl

    def on_master_scale_changed(self, scale):
        val = int(scale.get_value())
        self.lbl_master_val.set_text(str(val))
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{val}%"], capture_output=True)

    def on_app_scale_changed(self, input_idx, scale):
        val = int(scale.get_value())
        if hasattr(scale, "lbl_ref"):
            scale.lbl_ref.set_text(str(val))
        subprocess.run(["pactl", "set-sink-input-volume", str(input_idx), f"{val}%"], capture_output=True)

    def on_cycle_output_device(self, btn):
        sinks = [s for s in self.get_pactl_json("sinks") if not s.get("name", "").endswith(".monitor")]
        if not sinks:
            return
        def_sink = self.get_default_sink()
        
        # Find next sink
        next_sink = sinks[0].get("name")
        for idx, s in enumerate(sinks):
            if s.get("name") == def_sink:
                next_sink = sinks[(idx + 1) % len(sinks)].get("name")
                break

        subprocess.run(["pactl", "set-default-sink", next_sink], capture_output=True)
        self.refresh_mixer()

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()

def main():
    css_provider = Gtk.CssProvider()
    css_provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        css_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    app = ExactVolumeMixer()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
