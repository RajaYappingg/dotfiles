    background-color: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 12px;
}

.card-title {
    font-size: 14px;
    font-weight: 700;
    color: #f1f5f9;
}

.card-badge {
    background-color: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}

.dev-btn {
    background-color: #0f172a;
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 12px;
}

.dev-btn:hover {
    background-color: #334155;
    color: #ffffff;
    border-color: #38bdf8;
}

.dev-btn.active {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border-color: #38bdf8;
}

scale trough {
    background-color: #0f172a;
    border-radius: 6px;
    min-height: 8px;
}

