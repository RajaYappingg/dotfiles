class MonitorCanvas(Gtk.DrawingArea):
    def __init__(self, parent_app):
        super().__init__()
        self.app = parent_app
        self.set_size_request(-1, 160)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK
        )

        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)
        self.connect("motion-notify-event", self.on_motion_notify)

        self.dragged_mon = None
        self.drag_start_x = 0
        self.drag_start_y = 0

        # Mon positions in desktop coordinates
        # Mon 1 (eDP-1): (0, 0)
        # Mon 2 (HDMI-A-1): (1920, 0) default
        self.m1_pos = [0, 0]
        self.m2_pos = [1920, 0]

    def set_mon_positions(self, m1_pos, m2_pos):
        self.m1_pos = list(m1_pos)
        self.m2_pos = list(m2_pos)
        self.queue_draw()

    def get_layout_bounds(self):
        # Scale 1920x1080 screens to fit inside canvas
        w = self.get_allocated_width() or 700
        h = self.get_allocated_height() or 160

        # Mon rect aspect ratio (16:9 -> 120x67 px on canvas)
        mon_w, mon_h = 130, 73
        center_x, center_y = w / 2, h / 2

        # Relative offset: 1920px -> ~140px on canvas
        scale = 140.0 / 1920.0

        # Calculate canvas rects for mon 1 and mon 2
        m1_cx = center_x + self.m1_pos[0] * scale - (mon_w / 2 if self.m1_pos[0] == 0 and self.m2_pos[0] == 0 else 0)
        m1_cy = center_y + self.m1_pos[1] * scale

        m2_cx = center_x + self.m2_pos[0] * scale
        m2_cy = center_y + self.m2_pos[1] * scale

        # Adjust center if m2 is right of m1
        if self.m2_pos[0] > 0:
            m1_x = center_x - mon_w - 6
            m2_x = center_x + 6
            m1_y = center_y - mon_h / 2
            m2_y = center_y - mon_h / 2
        elif self.m2_pos[0] < 0:
            m2_x = center_x - mon_w - 6
            m1_x = center_x + 6
            m1_y = center_y - mon_h / 2
            m2_y = center_y - mon_h / 2
        elif self.m2_pos[1] < 0:
            m1_x = center_x - mon_w / 2
            m2_x = center_x - mon_w / 2
            m2_y = center_y - mon_h - 6
            m1_y = center_y + 6
        elif self.m2_pos[1] > 0:
            m1_x = center_x - mon_w / 2
            m2_x = center_x - mon_w / 2
            m1_y = center_y - mon_h - 6
            m2_y = center_y + 6
        else: # Mirror
            m1_x = center_x - mon_w / 2
            m2_x = center_x - mon_w / 2
            m1_y = center_y - mon_h / 2
            m2_y = center_y - mon_h / 2

        r1 = (m1_x, m1_y, mon_w, mon_h)
        r2 = (m2_x, m2_y, mon_w, mon_h)
        return r1, r2

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()

        # Canvas background grid
        cr.set_source_rgba(0.06, 0.09, 0.16, 1.0)
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # Border
        cr.set_source_rgba(0.2, 0.3, 0.4, 0.4)
        cr.set_line_width(1)
        cr.rectangle(1, 1, w - 2, h - 2)
        cr.stroke()

        r1, r2 = self.get_layout_bounds()

        # Draw Monitor 1 (eDP-1 Laptop)
        self.draw_monitor_box(cr, r1, "💻 Laptop (eDP-1)", self.app.m1_enabled, self.app.primary_mon == "eDP-1", "#38bdf8")

        # Draw Monitor 2 (HDMI-A-1 MSI)
        self.draw_monitor_box(cr, r2, "🖥️ Monitor 2 (HDMI-A-1)", self.app.m2_enabled, self.app.primary_mon == "HDMI-A-1", "#818cf8")

    def draw_monitor_box(self, cr, rect, label, is_enabled, is_primary, color_hex):
        x, y, w, h = rect
        
        # Parse color
        if is_enabled:
            cr.set_source_rgba(0.12, 0.18, 0.28, 0.9)
        else:
            cr.set_source_rgba(0.08, 0.08, 0.12, 0.6)

        # Rounded rectangle
        radius = 8
        cr.new_sub_path()
        cr.arc(x + w - radius, y + radius, radius, -math.pi/2, 0)
        cr.arc(x + w - radius, y + h - radius, radius, 0, math.pi/2)
        cr.arc(x + radius, y + h - radius, radius, math.pi/2, math.pi)
        cr.arc(x + radius, y + radius, radius, math.pi, 3*math.pi/2)
        cr.close_path()
        cr.fill_preserve()

        # Border color
        if is_primary:
            cr.set_source_rgba(0.98, 0.75, 0.14, 0.9) # Gold for primary
            cr.set_line_width(2.5)
        elif is_enabled:
            cr.set_source_rgba(0.22, 0.74, 0.97, 0.7) # Cyan
            cr.set_line_width(1.5)
        else:
            cr.set_source_rgba(0.93, 0.27, 0.27, 0.5) # Red for off
            cr.set_line_width(1.5)

        cr.stroke()

        # Monitor Label & Badge
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.9 if is_enabled else 0.4)
        cr.set_font_size(10)
        cr.move_to(x + 10, y + 25)
        cr.show_text(label)

        status_str = "OFF" if not is_enabled else ("PRIMARY (0,0)" if is_primary else "SECONDARY")
        cr.set_font_size(9)
        if is_primary:
            cr.set_source_rgba(0.98, 0.75, 0.14, 1.0)
        elif is_enabled:
            cr.set_source_rgba(0.58, 0.74, 0.97, 0.8)
        else:
            cr.set_source_rgba(0.93, 0.27, 0.27, 0.8)
        
        cr.move_to(x + 10, y + 45)
        cr.show_text(f"[{status_str}]")

    def on_button_press(self, widget, event):
        if event.button == 1:
            r1, r2 = self.get_layout_bounds()
            ex, ey = event.x, event.y
            if r2[0] <= ex <= r2[0] + r2[2] and r2[1] <= ey <= r2[1] + r2[3]:
                self.dragged_mon = "HDMI-A-1"
                self.drag_start_x = ex
                self.drag_start_y = ey
            elif r1[0] <= ex <= r1[0] + r1[2] and r1[1] <= ey <= r1[1] + r1[3]:
                self.dragged_mon = "eDP-1"
                self.drag_start_x = ex
                self.drag_start_y = ey

    def on_motion_notify(self, widget, event):
        if self.dragged_mon:
            dx = event.x - self.drag_start_x
            dy = event.y - self.drag_start_y

            if abs(dx) > 35:
                if dx > 0:
                    self.app.set_mon2_position("right")
                else:
                    self.app.set_mon2_position("left")
                self.dragged_mon = None
            elif abs(dy) > 25:
                if dy > 0:
                    self.app.set_mon2_position("bottom")
                else:
                    self.app.set_mon2_position("top")
                self.dragged_mon = None

    def on_button_release(self, widget, event):
        self.dragged_mon = None

class DisplaySuperApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Display & Monitor Super App")
        self.set_name("superapp-window")
        self.set_default_size(820, 680)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("floating_sys", "floating_sys")

        # Monitor state tracking
        self.m1_enabled = True
        self.m2_enabled = True
        self.primary_mon = "eDP-1" # "eDP-1" or "HDMI-A-1"
        self.m2_pos_name = "right" # "right", "left", "top", "bottom", "mirror"

        self.detect_current_state()

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # 1. Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("header-box")

        title_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(label="🖥️ DISPLAY & MONITOR SUPER APP", xalign=0)
        lbl_title.get_style_context().add_class("header-title")
        lbl_sub = Gtk.Label(label="Pusat Kontrol Layar, Posisi Drag & Drop, Refresh Rate & Kecerahan", xalign=0)
        lbl_sub.get_style_context().add_class("header-sub")
        title_vbox.pack_start(lbl_title, False, False, 0)
        title_vbox.pack_start(lbl_sub, False, False, 0)

        header.pack_start(title_vbox, True, True, 0)

        btn_close = Gtk.Button(label=" ✕ ")
        btn_close.get_style_context().add_class("close-btn")
        btn_close.connect("clicked", lambda b: self.close())
        header.pack_start(btn_close, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # Scrolled Container
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content_vbox.set_margin_top(16)
        content_vbox.set_margin_bottom(16)
        content_vbox.set_margin_left(20)
        content_vbox.set_margin_right(20)
        scrolled.add(content_vbox)
        main_box.pack_start(scrolled, True, True, 0)

        # 2. Interactive Monitor Canvas & Layout Arrangement Card
        canvas_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        canvas_card.get_style_context().add_class("card-box")

        c_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_c_title = Gtk.Label(label="📐 Tata Letak & Posisi Monitor (Drag & Drop Canvas)", xalign=0)
        lbl_c_title.get_style_context().add_class("card-title")
        c_header.pack_start(lbl_c_title, True, True, 0)
        canvas_card.pack_start(c_header, False, False, 0)

        # Interactive Canvas
        self.canvas = MonitorCanvas(self)
        canvas_card.pack_start(self.canvas, False, False, 0)

        # Quick Position Controls
        pos_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        pos_box.set_homogeneous(True)

        positions = [
            ("⬅️ Kiri", "left"),
            ("➡️ Kanan", "right"),
            ("⬆️ Atas", "top"),
            ("⬇️ Bawah", "bottom"),
            ("🖥️ Mirror", "mirror"),
        ]

        for p_label, p_val in positions:
            btn = Gtk.Button(label=p_label)
            btn.get_style_context().add_class("pos-btn")
            btn.connect("clicked", lambda b, val=p_val: self.set_mon2_position(val))
            pos_box.pack_start(btn, True, True, 0)

        canvas_card.pack_start(pos_box, False, False, 0)
        content_vbox.pack_start(canvas_card, False, False, 0)

        # 3. Quick Mode Presets Section
        preset_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        preset_card.get_style_context().add_class("card-box")

        lbl_p_title = Gtk.Label(label="🚀 Mode Presets (1-Click Settings)", xalign=0)
        lbl_p_title.get_style_context().add_class("card-title")
        preset_card.pack_start(lbl_p_title, False, False, 0)

        preset_grid = Gtk.Grid()
        preset_grid.set_column_spacing(10)
        preset_grid.set_row_spacing(8)
        preset_grid.set_column_homogeneous(True)

        presets = [
            ("🎮 Gaming Ultra", "Mon 2: 180Hz | 100%\nMon 1: 144Hz | 100%", self.apply_preset_gaming),
            ("💼 Work / Balanced", "Mon 2: 144Hz | 75%\nMon 1: 144Hz | 75%", self.apply_preset_work),
            ("🔋 Battery Eco", "Mon 2: 60Hz | 50%\nMon 1: 60Hz | 40%", self.apply_preset_eco),
            ("🌙 Night Mode", "Mon 2: 60Hz | 20%\nMon 1: 60Hz | 20%", self.apply_preset_night),
        ]

        for idx, (p_title, p_desc, p_func) in enumerate(presets):
            btn = Gtk.Button(label=f"{p_title}\n{p_desc}")
            btn.get_style_context().add_class("preset-btn")
            btn.connect("clicked", lambda b, f=p_func: f())
            preset_grid.attach(btn, idx % 2, idx // 2, 1, 1)

        preset_card.pack_start(preset_grid, False, False, 0)
        content_vbox.pack_start(preset_card, False, False, 0)

        # 4. Monitor 2 Control Card (MSI G255F - HDMI-A-1)
        self.mon2_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.mon2_card.get_style_context().add_class("card-box")

        m2_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_m2 = Gtk.Label(label="🖥️ MONITOR 2 (MSI G255F - HDMI-A-1)", xalign=0)
        lbl_m2.get_style_context().add_class("card-title")
        
        self.badge_m2_status = Gtk.Label(label="OFF" if not self.m2_enabled else ("PRIMARY" if self.primary_mon == "HDMI-A-1" else "SECONDARY"))
        self.badge_m2_status.get_style_context().add_class("card-badge")
        if self.primary_mon == "HDMI-A-1":
            self.badge_m2_status.get_style_context().add_class("primary")

        m2_header.pack_start(lbl_m2, True, True, 0)
        m2_header.pack_start(self.badge_m2_status, False, False, 0)
        self.mon2_card.pack_start(m2_header, False, False, 0)

        # Monitor 2 Action Buttons (Primary & Power Toggle)
        m2_actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        
        self.btn_m2_primary = Gtk.Button(label="⭐ Set As Primary Display")
        self.btn_m2_primary.get_style_context().add_class("primary-btn")
        self.btn_m2_primary.connect("clicked", lambda b: self.set_primary_display("HDMI-A-1"))
        m2_actions.pack_start(self.btn_m2_primary, True, True, 0)

        self.btn_m2_power = Gtk.Button(label="🔴 Matikan Layar" if self.m2_enabled else "🟢 Nyalakan Layar")
        self.btn_m2_power.get_style_context().add_class("toggle-btn-on" if self.m2_enabled else "toggle-btn-off")
        self.btn_m2_power.connect("clicked", lambda b: self.toggle_monitor_power("HDMI-A-1"))
        m2_actions.pack_start(self.btn_m2_power, False, False, 0)

        self.mon2_card.pack_start(m2_actions, False, False, 0)

        # Monitor 2 Refresh Rate (Hz)
        self.mon2_card.pack_start(Gtk.Label(label="⚡ Refresh Rate (Hz):", xalign=0), False, False, 0)
        m2_hz_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        m2_hz_box.set_homogeneous(True)

        self.m2_rates = [60, 120, 144, 165, 180]
        self.m2_hz_buttons = {}
        curr_m2_hz = self.get_hz("HDMI-A-1")

        for r in self.m2_rates:
            btn = Gtk.Button(label=f"{r}Hz")
            btn.get_style_context().add_class("hz-btn")
            if r == curr_m2_hz:
                btn.get_style_context().add_class("active")
            btn.connect("clicked", lambda b, rate=r: self.set_m2_hz(rate))
            m2_hz_box.pack_start(btn, True, True, 0)
            self.m2_hz_buttons[r] = btn

        self.mon2_card.pack_start(m2_hz_box, False, False, 0)

        # Monitor 2 Brightness Slider
        self.mon2_card.pack_start(Gtk.Label(label="🔆 Kecerahan Screen:", xalign=0), False, False, 0)
        m2_b_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        curr_m2_b = self.get_m2_brightness()
        self.m2_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 100, 5)
        self.m2_scale.set_value(curr_m2_b)
        self.m2_scale.set_draw_value(False)
        self.m2_scale.connect("value-changed", self.on_m2_scale_changed)
        m2_b_box.pack_start(self.m2_scale, True, True, 0)

        self.lbl_m2_b_val = Gtk.Label(label=f"{curr_m2_b}%")
        self.lbl_m2_b_val.set_size_request(45, -1)
        self.lbl_m2_b_val.get_style_context().add_class("card-title")
        m2_b_box.pack_start(self.lbl_m2_b_val, False, False, 0)

        for p in [25, 50, 75, 100]:
            btn = Gtk.Button(label=f"{p}%")
            btn.get_style_context().add_class("quick-bright-btn")
            btn.connect("clicked", lambda b, val=p: self.m2_scale.set_value(val))
            m2_b_box.pack_start(btn, False, False, 0)

        self.mon2_card.pack_start(m2_b_box, False, False, 0)
        content_vbox.pack_start(self.mon2_card, False, False, 0)

        # 5. Monitor 1 Control Card (BOE Laptop - eDP-1)
        self.mon1_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.mon1_card.get_style_context().add_class("card-box")

        m1_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_m1 = Gtk.Label(label="💻 MONITOR 1 (Laptop BOE - eDP-1)", xalign=0)
        lbl_m1.get_style_context().add_class("card-title")

        self.badge_m1_status = Gtk.Label(label="OFF" if not self.m1_enabled else ("PRIMARY" if self.primary_mon == "eDP-1" else "SECONDARY"))
        self.badge_m1_status.get_style_context().add_class("card-badge")
        if self.primary_mon == "eDP-1":
            self.badge_m1_status.get_style_context().add_class("primary")

        m1_header.pack_start(lbl_m1, True, True, 0)
        m1_header.pack_start(self.badge_m1_status, False, False, 0)
        self.mon1_card.pack_start(m1_header, False, False, 0)

        # Monitor 1 Action Buttons
        m1_actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        
        self.btn_m1_primary = Gtk.Button(label="⭐ Set As Primary Display")
        self.btn_m1_primary.get_style_context().add_class("primary-btn")
        self.btn_m1_primary.connect("clicked", lambda b: self.set_primary_display("eDP-1"))
        m1_actions.pack_start(self.btn_m1_primary, True, True, 0)

        self.btn_m1_power = Gtk.Button(label="🔴 Matikan Layar" if self.m1_enabled else "🟢 Nyalakan Layar")
        self.btn_m1_power.get_style_context().add_class("toggle-btn-on" if self.m1_enabled else "toggle-btn-off")
        self.btn_m1_power.connect("clicked", lambda b: self.toggle_monitor_power("eDP-1"))
        m1_actions.pack_start(self.btn_m1_power, False, False, 0)

        self.mon1_card.pack_start(m1_actions, False, False, 0)

        # Monitor 1 Refresh Rate (Hz)
        self.mon1_card.pack_start(Gtk.Label(label="⚡ Refresh Rate (Hz):", xalign=0), False, False, 0)
        m1_hz_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        m1_hz_box.set_homogeneous(True)

        self.m1_rates = [60, 144]
        self.m1_hz_buttons = {}
        curr_m1_hz = self.get_hz("eDP-1")

        for r in self.m1_rates:
            btn = Gtk.Button(label=f"{r}Hz")
            btn.get_style_context().add_class("hz-btn")
            if r == curr_m1_hz:
                btn.get_style_context().add_class("active")
            btn.connect("clicked", lambda b, rate=r: self.set_m1_hz(rate))
            m1_hz_box.pack_start(btn, True, True, 0)
            self.m1_hz_buttons[r] = btn

        self.mon1_card.pack_start(m1_hz_box, False, False, 0)

        # Monitor 1 Brightness Slider
        self.mon1_card.pack_start(Gtk.Label(label="🔆 Kecerahan Screen:", xalign=0), False, False, 0)
        m1_b_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        curr_m1_b = self.get_m1_brightness()
        self.m1_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 100, 5)
        self.m1_scale.set_value(curr_m1_b)
        self.m1_scale.set_draw_value(False)
        self.m1_scale.connect("value-changed", self.on_m1_scale_changed)
        m1_b_box.pack_start(self.m1_scale, True, True, 0)

        self.lbl_m1_b_val = Gtk.Label(label=f"{curr_m1_b}%")
        self.lbl_m1_b_val.set_size_request(45, -1)
        self.lbl_m1_b_val.get_style_context().add_class("card-title")
        m1_b_box.pack_start(self.lbl_m1_b_val, False, False, 0)

        for p in [25, 50, 75, 100]:
            btn = Gtk.Button(label=f"{p}%")
            btn.get_style_context().add_class("quick-bright-btn")
            btn.connect("clicked", lambda b, val=p: self.m1_scale.set_value(val))
            m1_b_box.pack_start(btn, False, False, 0)

        self.mon1_card.pack_start(m1_b_box, False, False, 0)
        content_vbox.pack_start(self.mon1_card, False, False, 0)

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", Gtk.main_quit)

    def detect_current_state(self):
        try:
            res = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True)
            monitors = json.loads(res.stdout)
            
            m1_found = False
            m2_found = False

            for m in monitors:
                name = m.get("name")
                disabled = m.get("disabled", False)
                x = m.get("x", 0)
                y = m.get("y", 0)

                if name == "eDP-1":
                    m1_found = True
                    self.m1_enabled = not disabled
                    if x == 0 and y == 0:
                        self.primary_mon = "eDP-1"
                elif name == "HDMI-A-1":
                    m2_found = True
                    self.m2_enabled = not disabled
                    if x == 0 and y == 0:
                        self.primary_mon = "HDMI-A-1"
                    if x > 0:
                        self.m2_pos_name = "right"
                    elif x < 0:
                        self.m2_pos_name = "left"
                    elif y < 0:
                        self.m2_pos_name = "top"
                    elif y > 0:
                        self.m2_pos_name = "bottom"
                    elif x == 0 and y == 0 and self.primary_mon != "HDMI-A-1":
                        self.m2_pos_name = "mirror"

            if not m1_found:
                self.m1_enabled = False
            if not m2_found:
                self.m2_enabled = False

        except Exception:
            pass

    def get_hz(self, mon_name):
        try:
            res = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True)
            monitors = json.loads(res.stdout)
            for m in monitors:
                if m.get("name") == mon_name:
                    return round(m.get("refreshRate", 60))
        except Exception:
            pass
        return 60

    def get_m2_brightness(self):
        try:
            if os.path.exists("/tmp/.monitor2_brightness"):
                with open("/tmp/.monitor2_brightness", "r") as f:
                    return int(float(f.read().strip()))
        except Exception:
            pass
        return 100

    def get_m1_brightness(self):
        try:
            res = subprocess.run(["brightnessctl", "g"], capture_output=True, text=True)
            max_b = subprocess.run(["brightnessctl", "m"], capture_output=True, text=True)
            curr = int(res.stdout.strip())
            max_val = int(max_b.stdout.strip())
            return int((curr / max_val) * 100)
        except Exception:
            pass
        return 100

    def set_mon2_position(self, pos_name):
        self.m2_pos_name = pos_name
        hz = self.get_hz("HDMI-A-1")

        if pos_name == "right":
            pos_str = "1920x0"
            m1_pos, m2_pos = (0, 0), (1920, 0)
        elif pos_name == "left":
            pos_str = "-1920x0"
            m1_pos, m2_pos = (0, 0), (-1920, 0)
        elif pos_name == "top":
            pos_str = "0x-1080"
            m1_pos, m2_pos = (0, 0), (0, -1080)
        elif pos_name == "bottom":
            pos_str = "0x1080"
            m1_pos, m2_pos = (0, 0), (0, 1080)
        elif pos_name == "mirror":
            pos_str = "0x0"
            m1_pos, m2_pos = (0, 0), (0, 0)

        cmd = f"hl.monitor({{ output = 'HDMI-A-1', mode = '1920x1080@{hz}', position = '{pos_str}', scale = 1 }})"
        subprocess.run(["hyprctl", "eval", cmd], capture_output=True)
        self.canvas.set_mon_positions(m1_pos, m2_pos)
        subprocess.run(["notify-send", "-r", "9915", "-i", "video-display", "Tata Letak Monitor", f"Posisi Monitor 2 diatur ke: {pos_name.upper()}"])

    def set_primary_display(self, mon_name):
        self.primary_mon = mon_name
        if mon_name == "HDMI-A-1":
            hz2 = self.get_hz("HDMI-A-1")
            hz1 = self.get_hz("eDP-1")
            cmd2 = f"hl.monitor({{ output = 'HDMI-A-1', mode = '1920x1080@{hz2}', position = '0x0', scale = 1 }})"
            cmd1 = f"hl.monitor({{ output = 'eDP-1', mode = '1920x1080@{hz1}', position = '1920x0', scale = 1 }})"
            subprocess.run(["hyprctl", "eval", cmd2], capture_output=True)
            subprocess.run(["hyprctl", "eval", cmd1], capture_output=True)
            self.canvas.set_mon_positions((1920, 0), (0, 0))
            self.badge_m2_status.set_text("PRIMARY")
            self.badge_m2_status.get_style_context().add_class("primary")
            self.badge_m1_status.set_text("SECONDARY")
            self.badge_m1_status.get_style_context().remove_class("primary")
        else:
            hz2 = self.get_hz("HDMI-A-1")
            hz1 = self.get_hz("eDP-1")
            cmd1 = f"hl.monitor({{ output = 'eDP-1', mode = '1920x1080@{hz1}', position = '0x0', scale = 1 }})"
            cmd2 = f"hl.monitor({{ output = 'HDMI-A-1', mode = '1920x1080@{hz2}', position = '1920x0', scale = 1 }})"
            subprocess.run(["hyprctl", "eval", cmd1], capture_output=True)
            subprocess.run(["hyprctl", "eval", cmd2], capture_output=True)
            self.canvas.set_mon_positions((0, 0), (1920, 0))
            self.badge_m1_status.set_text("PRIMARY")
            self.badge_m1_status.get_style_context().add_class("primary")
            self.badge_m2_status.set_text("SECONDARY")
            self.badge_m2_status.get_style_context().remove_class("primary")

        subprocess.run(["notify-send", "-r", "9916", "-i", "video-display", "Primary Display Changed", f"⭐ {mon_name} diatur sebagai Primary Display!"])

    def toggle_monitor_power(self, mon_name):
        if mon_name == "HDMI-A-1":
            if self.m2_enabled:
                cmd = "hl.monitor({ output = 'HDMI-A-1', mode = 'disable' })"
                subprocess.run(["hyprctl", "eval", cmd], capture_output=True)
                self.m2_enabled = False
                self.btn_m2_power.set_label("🟢 Nyalakan Layar")
                self.btn_m2_power.get_style_context().remove_class("toggle-btn-on")
                self.btn_m2_power.get_style_context().add_class("toggle-btn-off")
                self.badge_m2_status.set_text("OFF")
                self.badge_m2_status.get_style_context().add_class("off")
                subprocess.run(["notify-send", "-r", "9917", "-i", "display", "Monitor 2", "🔴 Monitor 2 Dinonaktifkan"])
            else:
                hz = self.get_hz("HDMI-A-1") or 180
                cmd = f"hl.monitor({{ output = 'HDMI-A-1', mode = '1920x1080@{hz}', position = '1920x0', scale = 1 }})"
                subprocess.run(["hyprctl", "eval", cmd], capture_output=True)
                self.m2_enabled = True
                self.btn_m2_power.set_label("🔴 Matikan Layar")
                self.btn_m2_power.get_style_context().remove_class("toggle-btn-off")
                self.btn_m2_power.get_style_context().add_class("toggle-btn-on")
                self.badge_m2_status.set_text("SECONDARY" if self.primary_mon != "HDMI-A-1" else "PRIMARY")
                self.badge_m2_status.get_style_context().remove_class("off")
                subprocess.run(["notify-send", "-r", "9917", "-i", "display", "Monitor 2", "🟢 Monitor 2 Dinyalakan"])
        else: # eDP-1
            if self.m1_enabled:
                cmd = "hl.monitor({ output = 'eDP-1', mode = 'disable' })"
                subprocess.run(["hyprctl", "eval", cmd], capture_output=True)
                self.m1_enabled = False
                self.btn_m1_power.set_label("🟢 Nyalakan Layar")
                self.btn_m1_power.get_style_context().remove_class("toggle-btn-on")
                self.btn_m1_power.get_style_context().add_class("toggle-btn-off")
                self.badge_m1_status.set_text("OFF")
                self.badge_m1_status.get_style_context().add_class("off")
                subprocess.run(["notify-send", "-r", "9918", "-i", "display", "Monitor Laptop", "🔴 Monitor Laptop Dinonaktifkan"])
            else:
                hz = self.get_hz("eDP-1") or 144
                cmd = f"hl.monitor({{ output = 'eDP-1', mode = '1920x1080@{hz}', position = '0x0', scale = 1 }})"
                subprocess.run(["hyprctl", "eval", cmd], capture_output=True)
                self.m1_enabled = True
                self.btn_m1_power.set_label("🔴 Matikan Layar")
                self.btn_m1_power.get_style_context().remove_class("toggle-btn-off")
                self.btn_m1_power.get_style_context().add_class("toggle-btn-on")
                self.badge_m1_status.set_text("PRIMARY" if self.primary_mon == "eDP-1" else "SECONDARY")
                self.badge_m1_status.get_style_context().remove_class("off")
                subprocess.run(["notify-send", "-r", "9918", "-i", "display", "Monitor Laptop", "🟢 Monitor Laptop Dinyalakan"])

        self.canvas.queue_draw()

    def set_m2_hz(self, rate):
        subprocess.run(["/home/zaki/.local/bin/monitor2-hz", str(rate)])
        for r, btn in self.m2_hz_buttons.items():
            if r == rate:
                btn.get_style_context().add_class("active")
            else:
                btn.get_style_context().remove_class("active")

    def set_m1_hz(self, rate):
        cmd = f"hl.monitor({{ output = 'eDP-1', mode = '1920x1080@{rate}', position = '0x0', scale = 1 }})"
        subprocess.run(["hyprctl", "eval", cmd], capture_output=True)
        subprocess.run(["notify-send", "-r", "9913", "-i", "video-display", "Monitor 1 Laptop", f"Refresh rate: {rate}Hz"])
        for r, btn in self.m1_hz_buttons.items():
            if r == rate:
                btn.get_style_context().add_class("active")
            else:
                btn.get_style_context().remove_class("active")

    def on_m2_scale_changed(self, scale):
        val = int(scale.get_value())
        self.lbl_m2_b_val.set_text(f"{val}%")
        subprocess.run(["/home/zaki/.local/bin/monitor2-brightness", str(val)])

    def on_m1_scale_changed(self, scale):
        val = int(scale.get_value())
        self.lbl_m1_b_val.set_text(f"{val}%")
        subprocess.run(["/home/zaki/.local/bin/change-brightness", str(val)])

    def apply_preset_gaming(self):
        self.set_m2_hz(180)
        self.set_m1_hz(144)
        self.m2_scale.set_value(100)
        self.m1_scale.set_value(100)
        subprocess.run(["notify-send", "-r", "9914", "-i", "input-gaming", "Preset Applied", "🎮 Gaming Ultra Mode Activated!"])

    def apply_preset_work(self):
        self.set_m2_hz(144)
        self.set_m1_hz(144)
        self.m2_scale.set_value(75)
        self.m1_scale.set_value(75)
        subprocess.run(["notify-send", "-r", "9914", "-i", "preferences-system", "Preset Applied", "💼 Work / Balanced Mode Activated!"])

    def apply_preset_eco(self):
        self.set_m2_hz(60)
        self.set_m1_hz(60)
        self.m2_scale.set_value(50)
        self.m1_scale.set_value(40)
        subprocess.run(["notify-send", "-r", "9914", "-i", "battery-good", "Preset Applied", "🔋 Battery Eco Mode Activated!"])

    def apply_preset_night(self):
        self.set_m2_hz(60)
        self.set_m1_hz(60)
        self.m2_scale.set_value(20)
        self.m1_scale.set_value(20)
        subprocess.run(["notify-send", "-r", "9914", "-i", "night-light", "Preset Applied", "🌙 Night Mode Activated!"])

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()

def main():
    css_provider = Gtk.CssProvider()
    css_provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        css_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    app = DisplaySuperApp()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
