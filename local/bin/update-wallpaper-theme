#!/usr/bin/env python3
import os
import sys
import math
import colorsys
import json
import hashlib
import subprocess

import gi
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import GdkPixbuf

CACHE_WALLPAPER = os.path.expanduser("~/.cache/current_wallpaper")
WAYBAR_COLORS_CSS = os.path.expanduser("~/.config/waybar/colors.css")
WAYBAR_DOTFILES_COLORS = os.path.expanduser("~/dotfiles/config/waybar/colors.css")
FASTFETCH_CONFIG = os.path.expanduser("~/.config/fastfetch/config.jsonc")
FASTFETCH_DOTFILES = os.path.expanduser("~/dotfiles/config/fastfetch/config.jsonc")
DUNST_CONFIG = os.path.expanduser("~/.config/dunst/dunstrc")
DUNST_DOTFILES = os.path.expanduser("~/dotfiles/config/dunst/dunstrc")

VIDEO_EXTS = {'.mp4', '.mkv', '.webm', '.avi', '.mov'}

def get_wallpaper_image_path(wallpaper_path):
    if not wallpaper_path or not os.path.exists(wallpaper_path):
        return None

    ext = os.path.splitext(wallpaper_path)[1].lower()
    if ext in VIDEO_EXTS:
        thumb_dir = os.path.expanduser("~/.cache/wallpaper_thumbs")
        os.makedirs(thumb_dir, exist_ok=True)
        mtime = os.path.getmtime(wallpaper_path)
        file_hash = hashlib.md5(f"{wallpaper_path}_{mtime}".encode('utf-8')).hexdigest()
        cache_thumb = os.path.join(thumb_dir, f"{file_hash}.jpg")

        if not os.path.exists(cache_thumb):
            try:
                cmd = [
                    "ffmpeg", "-y", "-ss", "00:00:01", "-i", wallpaper_path,
                    "-vframes", "1", "-vf", "scale=320:180:force_original_aspect_ratio=decrease",
                    cache_thumb
                ]
                subprocess.run(cmd, capture_output=True, check=True)
            except Exception:
                return None

        return cache_thumb if os.path.exists(cache_thumb) else None

    return wallpaper_path

def extract_palette(image_path):
    default_palette = {
        'primary': '#00b4db',
        'secondary': '#0083b0',
        'bg_dark': '#0b0f19',
        'bg_pill': '#141a24',
        'border': '#00b4db',
        'text': '#ffffff',
        'fastfetch_key': 'cyan',
        'fastfetch_title': 'blue'
    }

    if not image_path or not os.path.exists(image_path):
        return default_palette

    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(image_path, 80, 80, False)
    except Exception:
        return default_palette

    pixels = pixbuf.get_pixels()
    n_channels = pixbuf.get_n_channels()
    rowstride = pixbuf.get_rowstride()
    w, h = pixbuf.get_width(), pixbuf.get_height()

    bucket_scores = {}
    bucket_pixels = {}

    for y in range(0, h, 2):
        for x in range(0, w, 2):
            idx = y * rowstride + x * n_channels
            r = pixels[idx]
            g = pixels[idx + 1]
            b = pixels[idx + 2]

            h_val, s_val, v_val = colorsys.rgb_to_hsv(r/255.0, g/255.0, b/255.0)

            # Filter out extreme blacks/whites/grays
            if s_val < 0.15 or v_val < 0.15:
                continue

            # Group into 12 hue buckets (30 degrees each)
            hue_bucket = int(h_val * 12) % 12
            score = 1.0 + (s_val * 1.5) + (v_val * 0.5)

            bucket_scores[hue_bucket] = bucket_scores.get(hue_bucket, 0) + score
            if hue_bucket not in bucket_pixels:
                bucket_pixels[hue_bucket] = []
            bucket_pixels[hue_bucket].append((r, g, b, h_val, s_val, v_val))

    if not bucket_scores:
        return default_palette

    sorted_buckets = sorted(bucket_scores.items(), key=lambda item: item[1], reverse=True)
    
    # 1. Pick dominant hue bucket
    primary_bucket = sorted_buckets[0][0]
    primary_candidates = bucket_pixels[primary_bucket]
    primary_candidates.sort(key=lambda c: (c[4] * 1.5) + c[5], reverse=True)
    top_p = primary_candidates[0]

    h_val, s_val, v_val = top_p[3], top_p[4], top_p[5]
    v_boosted = max(0.80, v_val)
    s_boosted = min(1.0, max(0.45, s_val))
    pr_f, pg_f, pb_f = colorsys.hsv_to_rgb(h_val, s_boosted, v_boosted)
    primary_rgb = (int(pr_f * 255), int(pg_f * 255), int(pb_f * 255))

    # 2. Pick secondary color from 2nd dominant bucket
    secondary_rgb = primary_rgb
    if len(sorted_buckets) > 1:
        sec_bucket = sorted_buckets[1][0]
        sec_candidates = bucket_pixels[sec_bucket]
        sec_candidates.sort(key=lambda c: (c[4] * 1.5) + c[5], reverse=True)
        top_s = sec_candidates[0]
        sh_val, ss_val, sv_val = top_s[3], top_s[4], top_s[5]
        sr_f, sg_f, sb_f = colorsys.hsv_to_rgb(sh_val, min(1.0, ss_val * 1.1), max(0.75, sv_val))
        secondary_rgb = (int(sr_f * 255), int(sg_f * 255), int(sb_f * 255))

    # Calculate wallpaper-tinted dark pill background
    pr, pg, pb = primary_rgb
    bg_r = int(pr * 0.10 + 12)
    bg_g = int(pg * 0.08 + 10)
    bg_b = int(pb * 0.12 + 16)

    pill_r = int(pr * 0.16 + 20)
    pill_g = int(pg * 0.14 + 18)
    pill_b = int(pb * 0.18 + 26)

    primary_hex = f"#{primary_rgb[0]:02x}{primary_rgb[1]:02x}{primary_rgb[2]:02x}"
    secondary_hex = f"#{secondary_rgb[0]:02x}{secondary_rgb[1]:02x}{secondary_rgb[2]:02x}"
    bg_dark_hex = f"#{bg_r:02x}{bg_g:02x}{bg_b:02x}"
    bg_pill_hex = f"#{pill_r:02x}{pill_g:02x}{pill_b:02x}"

    fastfetch_rgb = f"38;2;{primary_rgb[0]};{primary_rgb[1]};{primary_rgb[2]}"

    return {
        'primary': primary_hex,
        'secondary': secondary_hex,
        'bg_dark': bg_dark_hex,
        'bg_pill': bg_pill_hex,
        'border': primary_hex,
        'text': '#ffffff',
        'fastfetch_key': fastfetch_rgb,
        'fastfetch_title': fastfetch_rgb
    }

def update_waybar_colors(palette):
    css_content = f"""/* Dynamic Colors Generated from Wallpaper */
@define-color primary {palette['primary']};
@define-color secondary {palette['secondary']};
@define-color bg_dark {palette['bg_dark']};
@define-color bg_pill {palette['bg_pill']};
@define-color text_main {palette['text']};
@define-color border_accent {palette['primary']};
"""
    os.makedirs(os.path.dirname(WAYBAR_COLORS_CSS), exist_ok=True)
    with open(WAYBAR_COLORS_CSS, "w") as f:
        f.write(css_content)

    if os.path.exists(os.path.dirname(WAYBAR_DOTFILES_COLORS)):
        with open(WAYBAR_DOTFILES_COLORS, "w") as f:
            f.write(css_content)

def update_fastfetch_colors(palette):
    if not os.path.exists(FASTFETCH_CONFIG):
        return

    try:
        with open(FASTFETCH_CONFIG, "r") as f:
            lines = f.readlines()

        new_lines = []
        for line in lines:
            if '"keys":' in line:
                new_lines.append(f'      "keys": "{palette["fastfetch_key"]}",\n')
            elif '"title":' in line and '"display":' not in line:
                new_lines.append(f'      "title": "{palette["fastfetch_title"]}"\n')
            else:
                new_lines.append(line)

        content_str = "".join(new_lines)
        if '"color":' not in content_str:
            content_str = content_str.replace(
                '"display": {\n    "separator": " ➜  "\n  },',
                f'"display": {{\n    "separator": " ➜  ",\n    "color": {{\n      "keys": "{palette["fastfetch_key"]}",\n      "title": "{palette["fastfetch_title"]}"\n    }}\n  }},'
            )

        with open(FASTFETCH_CONFIG, "w") as f:
            f.write(content_str)

        if os.path.exists(os.path.dirname(FASTFETCH_DOTFILES)):
            with open(FASTFETCH_DOTFILES, "w") as f:
                f.write(content_str)
    except Exception as e:
        print(f"Error updating fastfetch config: {e}")

def update_dunst_colors(palette):
    bg_alpha = f"{palette['bg_pill']}E6"  # ~90% opacity (dark glassmorphism, readable text)
    primary = palette['primary']

    dunstrc_content = f"""[global]
    monitor = 0
    follow = mouse
    width = (320, 440)
    height = 140
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 5
    history_length = 50

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    indicate_missing = yes
    separator_color = frame
    separator_height = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 2
    frame_color = "{primary}"
    gap_size = 10

    font = Inter 10.5, FiraCode Nerd Font 10.5
    line_height = 3
    format = "<b><span size='medium'>%s</span></b>\\n<span size='small'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 48
    max_icon_size = 80
    corner_radius = 12

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{bg_alpha}"
    foreground = "#ffffff"
    frame_color = "{primary}"
    highlight = "{primary}"
    timeout = 4

[urgency_normal]
    background = "{bg_alpha}"
    foreground = "#ffffff"
    frame_color = "{primary}"
    highlight = "{primary}"
    timeout = 5

[urgency_critical]
    background = "{bg_alpha}"
    foreground = "#ffffff"
    frame_color = "#ff5555"
    highlight = "#ff5555"
    timeout = 0
"""

    os.makedirs(os.path.dirname(DUNST_CONFIG), exist_ok=True)
    with open(DUNST_CONFIG, "w") as f:
        f.write(dunstrc_content)

    if os.path.exists(os.path.dirname(DUNST_DOTFILES)):
        with open(DUNST_DOTFILES, "w") as f:
            f.write(dunstrc_content)

    subprocess.run(["pkill", "-x", "dunst"], capture_output=True)

def main():
    wallpaper_path = None
    if len(sys.argv) > 1:
        wallpaper_path = sys.argv[1]
    elif os.path.exists(CACHE_WALLPAPER):
        with open(CACHE_WALLPAPER, "r") as f:
            wallpaper_path = f.read().strip()

    if not wallpaper_path:
        print("No wallpaper path provided or cached.")
        return

    img_path = get_wallpaper_image_path(wallpaper_path)
    palette = extract_palette(img_path)

    update_waybar_colors(palette)
    update_fastfetch_colors(palette)
    update_dunst_colors(palette)

    # Ensure single Waybar instance: reload if running, launch once if not
    res = subprocess.run(["pgrep", "-x", "waybar"], capture_output=True)
    if res.returncode == 0:
        subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"])
    else:
        subprocess.Popen(["waybar"])

    print(f"🎨 Theme updated successfully for wallpaper: {os.path.basename(wallpaper_path)}")
    print(f"   Primary Accent: {palette['primary']}")
    print(f"   Pill Background: {palette['bg_pill']}")
    print(f"   Dunst Opacity: 90% ({palette['bg_pill']}E6)")
    print(f"   Fastfetch Color: {palette['fastfetch_key']}")

if __name__ == "__main__":
    main()

