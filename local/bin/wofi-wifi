#!/usr/bin/env python3
import subprocess
import sys
import os

WOFI_CSS = os.path.expanduser("~/.config/wofi/wifi.css")

def run_cmd(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)

def notify(msg):
    run_cmd(["notify-send", "Wi-Fi Manager", msg])

def is_wifi_enabled():
    res = run_cmd(["nmcli", "radio", "wifi"])
    return res.stdout.strip().lower() == "enabled"

def get_networks():
    res = run_cmd(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"])
    networks = []
    seen = set()
    for line in res.stdout.strip().split("\n"):
        if not line:
            continue
        parts = line.replace(r"\:", "__COLON__").split(":")
        parts = [p.replace("__COLON__", ":") for p in parts]
        if len(parts) >= 3:
            in_use = (parts[0] == "*")
            ssid = parts[1].strip()
            signal = parts[2].strip()
            sec = parts[3].strip() if len(parts) > 3 else ""
            
            if not ssid:
                continue
            
            if ssid not in seen or in_use:
                seen.add(ssid)
                sig_val = int(signal) if signal.isdigit() else 0
                if sig_val > 75:
                    icon = "󰤨"
                elif sig_val > 50:
                    icon = "󰤥"
                elif sig_val > 25:
                    icon = "󰤢"
                else:
                    icon = "󰤟"
                
                networks.append({
                    "in_use": in_use,
                    "ssid": ssid,
                    "signal": signal,
                    "icon": icon,
                    "security": sec
                })
    networks.sort(key=lambda x: (not x["in_use"], -int(x["signal"]) if x["signal"].isdigit() else 0))
    return networks

def show_wofi_dmenu(prompt, lines, is_password=False, width=420, height=360):
    cmd = [
        "wofi",
        "--dmenu",
        "--prompt", prompt,
        "--style", WOFI_CSS,
        "--width", str(width),
        "--height", str(height),
        "--cache-file", "/dev/null"
    ]
    if is_password:
        cmd.append("--password")
    
    input_str = "\n".join(lines)
    res = subprocess.run(cmd, input=input_str, capture_output=True, text=True)
    return res.stdout.strip()

def main():
    if not is_wifi_enabled():
        lines = [
            "󰂲  [Enable Wi-Fi]",
            "󰅖  [Exit]"
        ]
        choice = show_wofi_dmenu("Wi-Fi Disabled", lines, height=180)
        if choice.startswith("󰂲"):
            run_cmd(["nmcli", "radio", "wifi", "on"])
            notify("Wi-Fi Enabled")
        return

    networks = get_networks()
    menu_lines = []
    net_map = {}

    for net in networks:
        status_tag = "  [Connected]" if net["in_use"] else ""
        sec_tag = f" ({net['security']})" if net['security'] and net['security'] != "--" else ""
        line = f"{net['icon']}  {net['ssid']}{status_tag}{sec_tag}"
        menu_lines.append(line)
        net_map[line] = net

    menu_lines.append("──────────────")
    menu_lines.append("󰑐  [Refresh List]")
    menu_lines.append("󰤮  [Disconnect Active Wi-Fi]")
    menu_lines.append("󰂲  [Disable Wi-Fi]")

    selected = show_wofi_dmenu("Wi-Fi Networks", menu_lines)

    if not selected or selected == "──────────────":
        return
    elif selected.startswith("󰑐"):
        run_cmd(["nmcli", "dev", "wifi", "rescan"])
        main()
    elif selected.startswith("󰤮"):
        run_cmd(["nmcli", "dev", "disconnect", "wlan0"])
        notify("Disconnected from Wi-Fi")
    elif selected.startswith("󰂲"):
        run_cmd(["nmcli", "radio", "wifi", "off"])
        notify("Wi-Fi Disabled")
    elif selected in net_map:
        target = net_map[selected]
        ssid = target["ssid"]
        
        if target["in_use"]:
            action = show_wofi_dmenu(f"Connected to {ssid}", ["Disconnect", "Cancel"], height=160)
            if action == "Disconnect":
                run_cmd(["nmcli", "dev", "disconnect", "wlan0"])
                notify(f"Disconnected from {ssid}")
            return

        # Attempt to connect directly
        res = run_cmd(["nmcli", "dev", "wifi", "connect", ssid])
        if res.returncode == 0:
            notify(f"Connected to {ssid}")
        else:
            # Ask password if initial attempt failed
            password = show_wofi_dmenu(f"Password for {ssid}", [], is_password=True, height=140)
            if password:
                res2 = run_cmd(["nmcli", "dev", "wifi", "connect", ssid, "password", password])
                if res2.returncode == 0:
                    notify(f"Connected to {ssid}")
                else:
                    err = res2.stderr.strip() or res2.stdout.strip()
                    notify(f"Connection failed: {err}")

if __name__ == "__main__":
    main()
