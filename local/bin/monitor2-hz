#!/usr/bin/env python3
import sys
import subprocess
import json

MONITOR_NAME = "HDMI-A-1"
POS = "1920x0"
SCALE = "1"
AVAILABLE_RATES = [60, 120, 144, 165, 180]

def get_current_hz():
    try:
        res = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True)
        monitors = json.loads(res.stdout)
        for m in monitors:
            if m.get("name") == MONITOR_NAME:
                rate = m.get("refreshRate", 60)
                return round(rate)
    except Exception:
        pass
    return 60

def set_hz(target_hz):
    target_hz = int(target_hz)
    cmd = f"hl.monitor({{ output = '{MONITOR_NAME}', mode = '1920x1080@{target_hz}', position = '{POS}', scale = {SCALE} }})"
    res = subprocess.run(["hyprctl", "eval", cmd], capture_output=True, text=True)
    
    # Notify user via dunst / notify-send
    icon = "video-display"
    title = "Monitor 2 Refresh Rate"
    message = f"Refresh rate diatur ke {target_hz}Hz ⚡"
    subprocess.run(["notify-send", "-r", "9911", "-i", icon, title, message])
    print(f"Set {MONITOR_NAME} to {target_hz}Hz")

def cycle_hz():
    curr = get_current_hz()
    # Find next higher rate or loop to lowest
    next_rate = AVAILABLE_RATES[0]
    for r in AVAILABLE_RATES:
        if r > curr:
            next_rate = r
            break
    set_hz(next_rate)

def main():
    if len(sys.argv) < 2:
        print("Usage: monitor2-hz <60|120|144|165|180|cycle>")
        sys.exit(1)

    arg = sys.argv[1].lower()
    if arg == "cycle" or arg == "toggle":
        cycle_hz()
    else:
        try:
            set_hz(int(arg))
        except ValueError:
            print(f"Invalid argument: {arg}")
            sys.exit(1)

if __name__ == "__main__":
    main()
