{
    "layer": "top",
    "position": "top",
    "output": ["*"],
    "height": 30,
    "spacing": 3,
    "margin-top": 4,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/cpu",
        "custom/memory",
        "custom/gpu",
        "custom/temperature",
        "network",
        "pulseaudio",
        "battery",
        "custom/notification"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "mpris": {
        "format": "{player_icon}  {artist} - {title}",
        "format-paused": "{status_icon}  {artist} - {title}",
        "player-icons": {
            "default": "󰎈",
            "firefox": "󰈹",
            "spotify": ""
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "max-length": 30
    },

    "clock": {
        "timezone": "Asia/Jakarta",
        "format": "󰥔  {:%H:%M  •  %a, %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "/home/zaki/.local/bin/calendar-popup"
    },

    "custom/cpu": {
        "exec": "/home/zaki/.local/bin/waybar-cpu",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "on-click": "kitty --class floating_sys -e btop",
        "on-click-right": "/home/zaki/.local/bin/waybar-cpu notify"
    },

    "custom/memory": {
        "exec": "/home/zaki/.local/bin/waybar-memory",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "on-click": "kitty --class floating_sys -e btop",
        "on-click-right": "/home/zaki/.local/bin/waybar-memory notify"
    },

    "custom/gpu": {
        "exec": "/home/zaki/.local/bin/waybar-gpu",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "on-click": "kitty --class floating_sys -e btop",
        "on-click-right": "/home/zaki/.local/bin/waybar-gpu notify"
    },

    "custom/temperature": {
        "exec": "/home/zaki/.local/bin/waybar-temp",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "on-click": "kitty --class floating_sys -e btop",
        "on-click-right": "/home/zaki/.local/bin/waybar-temp notify"
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  {ifname}",
        "format-disconnected": "󰤭  Offline",
        "tooltip-format": "󰤨 {essid} ({signalStrength}%)\n󰩟 {ifname} via {gwaddr}",
        "on-click": "kitty --class floating_wifi -e /home/zaki/.local/bin/wifi-menu",
        "interval": 5
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "󰕾 Volume: {volume}%\nKlik Kiri/Kanan: Buka Audio & Volume Control Mixer",
        "on-click": "/home/zaki/.local/bin/audio-control-gui",
        "on-click-right": "/home/zaki/.local/bin/audio-control-gui"
    },

    "battery": {
        "full-at": 100,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-full": "",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Battery: {capacity}%\nClick: Power Profiles Menu\nRight-Click: Battery Details",
        "on-click": "/home/zaki/.local/bin/battery-menu",
        "on-click-right": "/home/zaki/.local/bin/battery-info"
    },

    "custom/notification": {
        "exec": "/home/zaki/.local/bin/waybar-notification",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "on-click": "/home/zaki/.local/bin/waybar-notification pop",
        "on-click-right": "/home/zaki/.local/bin/waybar-notification clear",
        "on-click-middle": "/home/zaki/.local/bin/waybar-notification dnd"
    }
}
